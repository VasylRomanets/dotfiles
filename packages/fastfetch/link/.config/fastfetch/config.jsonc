{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "$HOME/.config/fastfetch/ascii/cat-looking-at-bug.txt",
    "color": {
      "1": "magenta",
      "2": "yellow",
      "3": "green",
      "4": "cyan",
      "5": "red",
    },
  },
  "display": {
    "separator": " • ",
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[1;33m❯ git log --author \"Vasyl Romanets\"",
    },
    "break",
    {
      "type": "custom",
      "key": " github",
      "keyColor": "magenta",
      "format": "https://github.com/vasylromanets",
    },
    {
      "type": "host",
      "key": "󰍹 host",
      "keyColor": "magenta"
    },
    {
      "type": "os",
      "key": " os",
      "keyColor": "magenta",
      "format": "{2} {10} {8}"
    },
    {
      "type": "uptime",
      "key": " uptime",
      "keyColor": "magenta",
    },
    {
      "type": "memory",
      "key": "󰍛 memory",
      "keyColor": "magenta",
    },
    {
      "type": "shell",
      "key": " shell",
      "keyColor": "magenta",
    },
    {
      "type": "terminal",
      "key": "󰆍 terminal",
      "keyColor": "magenta",
    },
    {
      "type": "terminalfont",
      "key": " font",
      "keyColor": "magenta",
    },
    {
      "type": "datetime",
      "key": " date",
      "keyColor": "magenta",
      "format": "{day-pretty}.{month-pretty}.{year} ({weekday})",
    },
    {
      "type": "custom",
      "key": " location",
      "keyColor": "magenta",
      "format": "Kyiv, Ukraine",
    },
    {
      "type": "weather",
      "location": "Kyiv",
      "key": " weather",
      "keyColor": "magenta",
      "outputFormat": "%t,+%C",
      "timeout": 2000,
    },
    {
      "type": "command",
      "key": " theme",
      "keyColor": "magenta",
      "text": "grep '^theme' $HOME/.config/ghostty/config.local.ghostty | awk '{print $3}' | tr -d '\"' | sed 's/-/ /g' | awk '{for(i=1;i<=NF;i++) $i=toupper(substr($i,1,1))substr($i,2); print}'",
    },
    "break",
    "colors",
  ],
}

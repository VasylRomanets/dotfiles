# Typography
# font-family = Hack Nerd Font
# font-family = Monaspace Neon
# font-family = GeistMono Nerd Font Mono
# font-family = Hasklig
# font-family = RobotoMono Nerd Font
# font-family = MartianMono Nerd Font
# font-family = JuliaMono
# font-family = CommitMono Nerd Font
font-family = MesloLGS Nerd Font Mono
font-size = 18
# font-thicken = true
adjust-cell-height = 6%

# Appearance
background-blur = 10
background-opacity = 0.95
cursor-opacity = 0.8
cursor-style = block_hollow
cursor-style-blink = false
# custom-shader = shaders/cursor_smear.glsl
minimum-contrast = 1.3
theme = everforest-dark-hard.ghostty

# Window
confirm-close-surface = true
title-report = false
window-padding-balance = true
window-padding-x = 10
window-padding-y = 10
window-save-state = always
window-title-font-family = MesloLGS Nerd Font Mono
window-vsync = true

# macOS
macos-auto-secure-input = true
macos-option-as-alt = left
macos-secure-input-indication = true
macos-titlebar-style = tabs
macos-window-buttons = hidden

# Clipboard
clipboard-paste-bracketed-safe = true
clipboard-paste-protection = true
clipboard-trim-trailing-spaces = true

# Notifications
desktop-notifications = false

# Shell
shell-integration = zsh
shell-integration-features = no-cursor

# Local overrides — not tracked in git;
# holds the currently active theme
# so switching themes doesn't dirty this file
config-file = ?config.local.ghostty

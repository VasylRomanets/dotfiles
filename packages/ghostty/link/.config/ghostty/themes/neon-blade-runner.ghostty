# Neon Blade Runner
# Palette from cliamp's theme by Tom di Mino:
# https://github.com/bjarneo/cliamp/blob/main/theme/themes/neon-blade-runner.toml
# That file has only background, text, accent, red, green and yellow; blue, cyan,
# the bright colors and the selection are derived from them.

background = #121212
foreground = #b8c4d0
cursor-color = #e8609a
cursor-text = #121212
selection-background = #412330
selection-foreground = #dfe6ee

palette = 0=#121212
palette = 1=#d65f7e
palette = 2=#4eb8a8
palette = 3=#d4a040
palette = 4=#5f87b5
palette = 5=#e8609a
palette = 6=#5cc8d0
palette = 7=#b8c4d0
palette = 8=#758494
palette = 9=#ee7a96
palette = 10=#6fd0c0
palette = 11=#e6b85c
palette = 12=#8aa9d0
palette = 13=#f27fb2
palette = 14=#85dce2
palette = 15=#dfe6ee

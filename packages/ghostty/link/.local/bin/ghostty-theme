#!/usr/bin/env bash

# Switch Ghostty themes interactively — fuzzy pick, direct select, or randomize.
#
# REQUIRES: fzf (brew install fzf)
#
# USAGE: ghostty-theme           — fuzzy picker
#        ghostty-theme <name>    — apply directly or pre-filter picker
#        ghostty-theme -r        — apply a random theme
#
# Author:  Vasyl Romanets
# GitHub:  https://github.com/vasylromanets
# Created: 2026-06-21
# License: MIT

themes_dir="${XDG_CONFIG_HOME:-$HOME/.config}/ghostty/themes"
config=$(realpath "${XDG_CONFIG_HOME:-$HOME/.config}/ghostty/config.ghostty")

favorite_builtin_themes=(
  "Black Metal" "Catppuccin Frappe" "Catppuccin Latte" "Catppuccin Macchiato"
  "Catppuccin Mocha" "Gruvbox Dark" "Gruvbox Dark Hard" "Gruvbox Material Dark"
  "Kanagawa Dragon" "Kanagawa Wave" "Monokai Pro" "Monokai Pro Octagon"
  "Nightfox" "Carbonfox" "Dawnfox" "Dayfox" "Duskfox" "Nordfox" "Terafox"
  "Nord" "Nord Wave" "Onenord" "Rose Pine" "Rose Pine Dawn" "Rose Pine Moon"
  "TokyoNight" "TokyoNight Day" "TokyoNight Moon" "TokyoNight Storm" "Vague"
)

local_themes=()
while IFS= read -r f; do
  local_themes+=("$f")
done < <(command ls "$themes_dir")

themes=("${favorite_builtin_themes[@]}" "${local_themes[@]}")

if [[ "$1" == "-r" ]]; then
  theme="${themes[RANDOM % ${#themes[@]}]}"
elif [[ -n "$1" ]] && printf '%s\n' "${themes[@]}" | grep -qxF "$1"; then
  theme="$1"
else
  theme=$(printf '%s\n' "${themes[@]}" | fzf --query="$1")
fi

[[ -z "$theme" ]] && exit 0

perl -i -pe "s/^theme = .*/theme = \"$theme\"/" "$config"
killall -USR2 ghostty
echo "$theme theme is applied."

[include]
  path = ~/.config/git/config.local

[init]
  defaultBranch = main

[core]
  pager = delta
  quotepath = false
  fsmonitor = true
  untrackedCache = true

[credential]
  helper =
  helper = /usr/local/share/gcm-core/git-credential-manager

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true

[fetch]
  prune = true
  pruneTags = true

[push]
  autoSetupRemote = true

[pull]
  rebase = true

[merge]
  conflictStyle = zdiff3

[diff]
  colorMoved = default
  algorithm = histogram
  mnemonicPrefix = true

[column]
  ui = auto

[branch]
  sort = -committerdate

[tag]
  sort = version:refname

[rerere]
  enabled = true
  autoupdate = true

[rebase]
  autoStash = true

[gpg]
  format = ssh

[gpg "ssh"]
  allowedSignersFile = ~/.config/git/allowed_signers

[commit]
  gpgSign = true

[tag]
  gpgSign = true

[help]
  autocorrect = prompt

[alias]
  a = add
  b = branch
  c = commit
  co = checkout
  d = diff
  f = fetch
  l = log --oneline --graph --decorate
  lp = log --graph --pretty=format:'%C(yellow)%h%Creset -%C(magenta)%d%Creset %s %C(green)(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
  p = push
  pu = pull
  s = status
  ss = status -s
  st = stash

[include]
  path = ~/.config/git/config.local
  path = ~/.local/state/theme/generated/delta.gitconfig

[init]
  defaultBranch = main

[core]
  pager = delta
  quotepath = false
  fsmonitor = true
  untrackedCache = true

[credential]
  helper =
  helper = /usr/local/share/gcm-core/git-credential-manager

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true

[fetch]
  prune = true
  pruneTags = true

[push]
  autoSetupRemote = true

[pull]
  rebase = true

[merge]
  conflictStyle = zdiff3

[diff]
  colorMoved = default
  algorithm = histogram
  mnemonicPrefix = true
  wsErrorHighlight = all

[column]
  ui = auto

[branch]
  sort = -committerdate

[tag]
  sort = version:refname

[rerere]
  enabled = true
  autoupdate = true

[rebase]
  autoStash = true

[gpg]
  format = ssh

[gpg "ssh"]
  allowedSignersFile = ~/.config/git/allowed_signers

[commit]
  gpgSign = true

[tag]
  gpgSign = true

[help]
  autocorrect = prompt

[alias]
  a = add
  b = branch
  c = commit
  co = checkout
  d = diff
  # Interactively pick changed files via fzf, previewing each diff through delta.
  di = "!git diff --color=always --stat=1000 --format=\"\" \"${@:-@}\" \
    | fzf --ansi -m --no-sort --reverse --tiebreak=index \
    --bind=\"alt-a:execute(git add {1})+down\" \
    --preview \"git diff ${*:-@} -- \\$(sed -E -e 's/^\\s*([^\\|]*)\\s*\\|.*/\\1/' -e 's/(.*)\\{(.*) => (.*)\\}(.*)/\\1\\2\\4 \\1\\3\\4/' <<< {}) | delta \" \
    | awk '{print $1}' #"
  f = fetch
  l = log --oneline --graph --decorate
  # Interactively browse the log via fzf, previewing each commit through delta.
  li = "!git log --graph --color=always --format=\"%C(auto)%h%d %s %C(black)%C(bold)<%an> %ci%C(auto)\" \"$@\" \
    | fzf --ansi -m --no-sort --reverse --tiebreak=index \
    --preview \"git show --color=always \\\"\\$(grep -oE '[a-f0-9]{7,}' <<< {} | head -1)\\\" | delta \" \
    --bind \"ctrl-o:execute: git shi \\\"\\$(grep -oE '[a-f0-9]{7,}' <<< {} | head -1)\\\"\" \
    | grep -oE '[a-f0-9]{7,}' #"
  lp = log --graph --pretty=format:'%C(yellow)%h%Creset -%C(magenta)%d%Creset %s %C(green)(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
  p = push
  pu = pull
  s = status
  # Interactively pick files from a commit via fzf, previewing each through delta.
  shi = "!git show --color=always --stat=1000 --format=\"\" \"${@:-@}\" \
    | fzf --ansi -m --no-sort --reverse --tiebreak=index \
    --preview \"git show ${@:-@} -- \\$(sed -E -e 's/^\\s*([^\\|]*)\\s*\\|.*/\\1/' -e 's/(.*)\\{(.*) => (.*)\\}(.*)/\\1\\2\\4 \\1\\3\\4/' <<< {}) | delta \" \
    --bind \"ctrl-o:execute: git show ${@:-@} -- \\$(sed -E -e 's/^\\s*([^\\|]*)\\s*\\|.*/\\1/' -e 's/(.*)\\{(.*) => (.*)\\}(.*)/\\1\\2\\4 \\1\\3\\4/' <<< {}) | delta | less -+F\" \
    | awk '{print $1}' #"
  ss = status -s
  st = stash
  # Interactively browse stashes via fzf, previewing each through delta.
  sti = "!git stash list --color=always \"$@\" \
    | fzf --ansi -m --no-sort --reverse --tiebreak=index \
    --preview \"git stash show --patch --color=always \\$(cut -d : -f 1 <<< {}) | delta \" \
    --bind \"ctrl-o:execute: git shi \\$(cut -d : -f 1 <<< {})\" \
    | cut -d : -f 1 #"

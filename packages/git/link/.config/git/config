[init]
  defaultBranch = main

[core]
  pager = delta
  quotepath = false
  fsmonitor = true
  untrackedCache = true

[credential]
  helper =
  helper = manager

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true

[fetch]
  prune = true
  pruneTags = true

[push]
  autoSetupRemote = true

[pull]
  rebase = true

[merge]
  conflictStyle = zdiff3

[diff]
  colorMoved = default
  algorithm = histogram
  mnemonicPrefix = true
  wsErrorHighlight = all

[column]
  ui = auto

[branch]
  sort = -committerdate

[tag]
  sort = version:refname
  gpgSign = true

[rerere]
  enabled = true
  autoupdate = true

[rebase]
  autoStash = true

[gpg]
  format = ssh

[gpg "ssh"]
  allowedSignersFile = ~/.config/git/allowed_signers

[commit]
  gpgSign = true

[help]
  autocorrect = prompt

[include]
  path = ~/.local/state/theme/generated/delta.gitconfig
  path = ~/.config/git/config.local

[delta]
  syntax-theme = "ember-soft"
  # Ember Soft's own delete/add accents (rose/olive) blended over its base
  # background using the same 15%/30% ratio as its own util.blend() calls.
  minus-style = syntax "#39302d"
  minus-emph-style = syntax "#4e3c3a"
  plus-style = syntax "#33352b"
  plus-emph-style = syntax "#434636"

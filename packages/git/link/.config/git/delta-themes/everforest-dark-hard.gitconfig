[delta]
  syntax-theme = "everforest-dark"
  # Everforest's official palette ships dedicated diff-line background colors
  # (bg_red/bg_green); the emph tier blends its red/green accents a bit
  # stronger over the same hard-variant base background.
  minus-style = syntax "#493b40"
  minus-emph-style = syntax "#60464a"
  plus-style = syntax "#3c4841"
  plus-emph-style = syntax "#4d5a4a"

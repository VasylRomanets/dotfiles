[delta]
  syntax-theme = "rose-pine"
  # Rose Pine has no true green, so added/removed lines are tinted with its
  # closest accents (Pine, Love) blended low-opacity over the theme's base
  # background — the "auto" default ignores the syntax-theme's palette.
  minus-style = syntax "#3b2536"
  minus-emph-style = syntax "#583145"
  plus-style = syntax "#1d2635"
  plus-emph-style = syntax "#203344"

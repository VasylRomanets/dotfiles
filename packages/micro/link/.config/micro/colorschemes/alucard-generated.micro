# Alucard

color-link default "#1f1f1f,#fffbeb"
color-link comment "#6c664b"
color-link identifier "#14710a"
color-link identifier.class "#036a96"
color-link identifier.var "#1f1f1f"
color-link constant "#a34d14"
color-link constant.number "#a34d14"
color-link constant.string "#846e15"
color-link constant.specialChar "#846e15"
color-link constant.string.url "#036a96"
color-link statement "#a3144d"
color-link symbol.operator "#1f1f1f"
color-link symbol.brackets "#1f1f1f"
color-link symbol.tag "#036a96"
color-link preproc "#1f1f1f"
color-link type "#a3144d"
color-link type.keyword "#a3144d"
color-link special "#036a96"
color-link underlined "#036a96,underline"
color-link error "bold #cb3a2a"
color-link todo "bold #846e15"
color-link selection "#1f1f1f,#cfcfde"
color-link hlsearch "#fffbeb,#644ac9"
color-link statusline "#fffbeb,#6d6c66"
color-link statusline.inactive "#6c664b,#ceccc0"
color-link tabbar "#6d6c66,#ceccc0"
color-link tabbar.inactive "#6c664b,#ceccc0"
color-link gutter-error "#cb3a2a"
color-link gutter-warning "#846e15"
color-link line-number "#6c664b,#ceccc0"
color-link current-line-number "#1f1f1f,#ceccc0"
color-link diff-added "#14710a"
color-link diff-modified "#846e15"
color-link diff-deleted "#cb3a2a"
color-link cursor-line "#e2deca"
color-link color-column "#e2deca"
color-link indent-char "#cecbbe"
color-link scrollbar "#6c664b"

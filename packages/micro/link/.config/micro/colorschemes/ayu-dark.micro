# Ayu Dark

color-link default "#bfbdb6,#0b0e14"
color-link comment "#5a6673"
color-link identifier "#ffb454"
color-link identifier.class "#59c2ff"
color-link identifier.var "#bfbdb6"
color-link constant "#e6b450"
color-link constant.number "#e6b450"
color-link constant.string "#aad94c"
color-link constant.specialChar "#95e6cb"
color-link constant.string.url "#bfbdb6"
color-link statement "#ff8f40"
color-link symbol.operator "#f29668"
color-link symbol.brackets "#bfbdb6"
color-link symbol.tag "#39bae6"
color-link preproc "#bfbdb6"
color-link type "#ff8f40"
color-link type.keyword "#ff8f40"
color-link special "#39bae6"
color-link underlined "#bfbdb6,underline"
color-link error "bold #d95757"
color-link todo "bold #f9af4f"
color-link selection "#bfbdb6,#193155"
color-link hlsearch "#0b0e14,#e6b450"
color-link statusline "#0b0e14,#80807d"
color-link statusline.inactive "#5a6673,#16181e"
color-link tabbar "#80807d,#16181e"
color-link tabbar.inactive "#5a6673,#16181e"
color-link gutter-error "#ea6c73"
color-link gutter-warning "#f9af4f"
color-link line-number "#5a6673,#16181e"
color-link current-line-number "#bfbdb6,#16181e"
color-link diff-added "#7fd962"
color-link diff-modified "#f9af4f"
color-link diff-deleted "#ea6c73"
color-link cursor-line "#161a24"
color-link color-column "#161a24"
color-link indent-char "#333438"
color-link scrollbar "#5a6673"

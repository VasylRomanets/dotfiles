# Ayu Light

color-link default "#5c6166,#f8f9fa"
color-link comment "#adaeb1"
color-link identifier "#eba400"
color-link identifier.class "#22a4e6"
color-link identifier.var "#5c6166"
color-link constant "#f29718"
color-link constant.number "#f29718"
color-link constant.string "#86b300"
color-link constant.specialChar "#4cbf99"
color-link constant.string.url "#5c6166"
color-link statement "#fa8532"
color-link symbol.operator "#f2a191"
color-link symbol.brackets "#5c6166"
color-link symbol.tag "#55b4d4"
color-link preproc "#5c6166"
color-link type "#fa8532"
color-link type.keyword "#fa8532"
color-link special "#55b4d4"
color-link underlined "#5c6166,underline"
color-link error "bold #e65050"
color-link todo "bold #eca944"
color-link selection "#5c6166,#d7e4f6"
color-link hlsearch "#f8f9fa,#f29718"
color-link statusline "#f8f9fa,#93969a"
color-link statusline.inactive "#adaeb1,#eff0f1"
color-link tabbar "#93969a,#eff0f1"
color-link tabbar.inactive "#adaeb1,#eff0f1"
color-link gutter-error "#ea6c6d"
color-link gutter-warning "#eca944"
color-link line-number "#adaeb1,#eff0f1"
color-link current-line-number "#5c6166,#eff0f1"
color-link diff-added "#6cbf43"
color-link diff-modified "#eca944"
color-link diff-deleted "#ea6c6d"
color-link cursor-line "#f0f1f3"
color-link color-column "#f0f1f3"
color-link indent-char "#d6d8d9"
color-link scrollbar "#adaeb1"

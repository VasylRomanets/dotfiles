# Ayu Mirage

color-link default "#cccac2,#1f2430"
color-link comment "#6e7c8f"
color-link identifier "#ffcd66"
color-link identifier.class "#73d0ff"
color-link identifier.var "#cccac2"
color-link constant "#ffcc66"
color-link constant.number "#ffcc66"
color-link constant.string "#d5ff80"
color-link constant.specialChar "#95e6cb"
color-link constant.string.url "#cccac2"
color-link statement "#ffa659"
color-link symbol.operator "#f29e74"
color-link symbol.brackets "#cccac2"
color-link symbol.tag "#5ccfe6"
color-link preproc "#cccac2"
color-link type "#ffa659"
color-link type.keyword "#ffa659"
color-link special "#5ccfe6"
color-link underlined "#cccac2,underline"
color-link error "bold #ff6666"
color-link todo "bold #facc6e"
color-link selection "#cccac2,#2b4768"
color-link hlsearch "#1f2430,#ffcc66"
color-link statusline "#1f2430,#8f908f"
color-link statusline.inactive "#6e7c8f,#292e39"
color-link tabbar "#8f908f,#292e39"
color-link tabbar.inactive "#6e7c8f,#292e39"
color-link gutter-error "#ed8274"
color-link gutter-warning "#facc6e"
color-link line-number "#6e7c8f,#292e39"
color-link current-line-number "#cccac2,#292e39"
color-link diff-added "#87d96c"
color-link diff-modified "#facc6e"
color-link diff-deleted "#ed8274"
color-link cursor-line "#1a1f29"
color-link color-column "#1a1f29"
color-link indent-char "#454950"
color-link scrollbar "#6e7c8f"

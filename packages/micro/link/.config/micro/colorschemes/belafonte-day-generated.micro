color-link type "#905e1f"
color-link type.keyword "#905e1f"
color-link special "#905e1f"
color-link underlined "#426a79,underline"
color-link error "bold #be100e"
color-link todo "bold #d08b30"
color-link selection "#45373c,#968c83"

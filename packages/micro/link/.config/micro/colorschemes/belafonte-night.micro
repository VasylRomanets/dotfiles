# Belafonte Night

color-link default "#968c83,#20111b"
color-link comment "#736866"
color-link identifier "#467080"
color-link identifier.class "#989a9c"
color-link identifier.var "#968c83"
color-link constant "#9f562e"
color-link constant.number "#9f562e"
color-link constant.string "#858162"
color-link constant.specialChar "#989a9c"
color-link constant.string.url "#467080"
color-link statement "#eaa549"
color-link symbol.operator "#756968"
color-link symbol.brackets "#756968"
color-link symbol.tag "#eaa549"
color-link preproc "#968c83"
color-link type "#eaa549"
color-link type.keyword "#eaa549"
color-link special "#eaa549"
color-link underlined "#467080,underline"
color-link error "bold #be100e"
color-link todo "bold #eaa549"
color-link selection "#968c83,#45373c"
color-link hlsearch "#20111b,#eaa549"

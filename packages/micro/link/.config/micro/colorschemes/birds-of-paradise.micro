# Birds Of Paradise

color-link default "#e0dbb7,#2a1f1d"
color-link comment "#9b6c4a"
color-link identifier "#5a86ad"
color-link identifier.class "#e0dbb7"
color-link identifier.var "#e0dbb7"
color-link constant "#e0dbb7"
color-link constant.number "#e99d2a"
color-link constant.string "#6ba18a"
color-link constant.specialChar "#e0dbb7"
color-link constant.string.url "#e0dbb7"
color-link statement "#ac80a6"
color-link symbol.operator "#ac80a6"
color-link symbol.brackets "#e0dbb7"
color-link symbol.tag "#e99d2a"
color-link preproc "#d19ecb"
color-link type "#93cfd7"
color-link type.keyword "#93cfd7"
color-link special "#e99d2a"
color-link underlined "#e0dbb7,underline"
color-link error "bold #e0dbb7"
color-link todo "bold #e99d2a"
color-link selection "#e0dbb7,#563c27"
color-link hlsearch "#2a1f1d,#74a6ad"
color-link statusline "#2a1f1d,#a09981"
color-link statusline.inactive "#9b6c4a,#352a26"
color-link tabbar "#a09981,#352a26"
color-link tabbar.inactive "#9b6c4a,#352a26"
color-link gutter-error "#be2d26"
color-link gutter-warning "#e99d2a"
color-link line-number "#9b6c4a,#352a26"
color-link current-line-number "#e0dbb7,#352a26"
color-link diff-added "#6ba18a"
color-link diff-modified "#e99d2a"
color-link diff-deleted "#be2d26"
color-link cursor-line "#241a19"
color-link color-column "#241a19"
color-link indent-char "#52483f"
color-link scrollbar "#9b6c4a"

# Carbonfox

color-link default "#f2f4f8,#161616"
color-link comment "#535353"
color-link identifier "#6690d9"
color-link identifier.class "#08bdba"
color-link identifier.var "#f9fbff"
color-link constant "#ee5396"
color-link constant.number "#08bdba"
color-link constant.string "#25be6a"
color-link constant.specialChar "#b6b8bb"
color-link constant.string.url "#b7bdf8"
color-link statement "#be95ff"
color-link symbol.operator "#33b1ff"
color-link symbol.brackets "#f9fbff"
color-link symbol.tag "#6690d9"
color-link preproc "#f9fbff"
color-link type "#be95ff"
color-link type.keyword "#be95ff"
color-link special "#6690d9"
color-link underlined "#b7bdf8,underline"
color-link error "bold #f9fbff"
color-link todo "bold #08bdba"
color-link selection "#f2f4f8,#f9fbff"
color-link hlsearch "#161616,#33b1ff"
color-link statusline "#161616,#a5a6a9"
color-link statusline.inactive "#535353,#232324"
color-link tabbar "#a5a6a9,#232324"
color-link tabbar.inactive "#535353,#232324"
color-link gutter-error "#ee5396"
color-link gutter-warning "#08bdba"
color-link line-number "#535353,#232324"
color-link current-line-number "#f2f4f8,#232324"
color-link diff-added "#25be6a"
color-link diff-modified "#08bdba"
color-link diff-deleted "#ee5396"
color-link cursor-line "#252525"
color-link color-column "#252525"
color-link indent-char "#464748"
color-link scrollbar "#535353"

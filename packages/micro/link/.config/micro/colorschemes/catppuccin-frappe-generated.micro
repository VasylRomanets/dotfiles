# Catppuccin Frappe

color-link default "#c6d0f5,#303446"
color-link comment "#949cbb"
color-link identifier "#8caaee"
color-link identifier.class "#e5c890"
color-link identifier.var "#c6d0f5"
color-link constant "#e78284"
color-link constant.number "#ef9f76"
color-link constant.string "#a6d189"
color-link constant.specialChar "#f4b8e4"
color-link constant.string.url "#babbf1"
color-link statement "#ca9ee6"
color-link symbol.operator "#81c8be"
color-link symbol.brackets "#949cbb"
color-link symbol.tag "#8caaee"
color-link preproc "#c6d0f5"
color-link type "#ca9ee6"
color-link type.keyword "#ca9ee6"
color-link special "#8caaee"
color-link underlined "#babbf1,underline"
color-link error "bold #c6d0f5"
color-link todo "bold #e5c890"
color-link selection "#c6d0f5,#494e63"
color-link hlsearch "#303446,#8caaee"
color-link statusline "#303446,#9299b8"
color-link statusline.inactive "#949cbb,#393d50"
color-link tabbar "#9299b8,#393d50"
color-link tabbar.inactive "#949cbb,#393d50"
color-link gutter-error "#e78284"
color-link gutter-warning "#e5c890"
color-link line-number "#949cbb,#393d50"
color-link current-line-number "#c6d0f5,#393d50"
color-link diff-added "#a6d189"
color-link diff-modified "#e5c890"
color-link diff-deleted "#e78284"
color-link cursor-line "#414559"
color-link color-column "#414559"
color-link indent-char "#51566c"
color-link scrollbar "#949cbb"

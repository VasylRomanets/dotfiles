# Catppuccin Mocha

color-link default "#cdd6f4,#1e1e2e"
color-link comment "#9399b2"
color-link identifier "#89b4fa"
color-link identifier.class "#f9e2af"
color-link identifier.var "#cdd6f4"
color-link constant "#f38ba8"
color-link constant.number "#fab387"
color-link constant.string "#a6e3a1"
color-link constant.specialChar "#f5c2e7"
color-link constant.string.url "#b4befe"
color-link statement "#cba6f7"
color-link symbol.operator "#94e2d5"
color-link symbol.brackets "#9399b2"
color-link symbol.tag "#89b4fa"
color-link preproc "#cdd6f4"
color-link type "#cba6f7"
color-link type.keyword "#cba6f7"
color-link special "#89b4fa"
color-link underlined "#b4befe,underline"
color-link error "bold #cdd6f4"
color-link todo "bold #f9e2af"
color-link selection "#cdd6f4,#3b3d4f"
color-link hlsearch "#1e1e2e,#89b4fa"
color-link statusline "#1e1e2e,#9096af"
color-link statusline.inactive "#9399b2,#28293a"
color-link tabbar "#9096af,#28293a"
color-link tabbar.inactive "#9399b2,#28293a"
color-link gutter-error "#f38ba8"
color-link gutter-warning "#f9e2af"
color-link line-number "#9399b2,#28293a"
color-link current-line-number "#cdd6f4,#28293a"
color-link diff-added "#a6e3a1"
color-link diff-modified "#f9e2af"
color-link diff-deleted "#f38ba8"
color-link cursor-line "#313244"
color-link color-column "#313244"
color-link indent-char "#44465a"
color-link scrollbar "#9399b2"

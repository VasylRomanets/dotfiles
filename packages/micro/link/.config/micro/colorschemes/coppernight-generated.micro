# Coppernight

color-link default "#cad3f5,#11111b"
color-link comment "#a5adcb"
color-link identifier "#8aadf4"
color-link identifier.class "#eed49f"
color-link identifier.var "#cad3f5"
color-link constant "#cad3f5"
color-link constant.number "#fab387"
color-link constant.string "#a6da95"
color-link constant.specialChar "#cad3f5"
color-link constant.string.url "#cad3f5"
color-link statement "#c6a0f6"
color-link symbol.operator "#8bd5ca"
color-link symbol.brackets "#8bd5ca"
color-link symbol.tag "#8aadf4"
color-link preproc "#cad3f5"
color-link type "#c6a0f6"
color-link type.keyword "#c6a0f6"
color-link special "#8aadf4"
color-link underlined "#cad3f5,underline"
color-link error "bold #cad3f5"
color-link todo "bold #eed49f"
color-link selection "#cad3f5,#313244"
color-link hlsearch "#11111b,#fab387"
color-link statusline "#11111b,#898fa9"
color-link statusline.inactive "#a5adcb,#1c1d28"
color-link tabbar "#898fa9,#1c1d28"
color-link tabbar.inactive "#a5adcb,#1c1d28"
color-link gutter-error "#ed8796"
color-link gutter-warning "#eed49f"
color-link line-number "#a5adcb,#1c1d28"
color-link current-line-number "#cad3f5,#1c1d28"
color-link diff-added "#a6da95"
color-link diff-modified "#eed49f"
color-link diff-deleted "#ed8796"
color-link cursor-line "#181825"
color-link color-column "#181825"
color-link indent-char "#3a3c4b"
color-link scrollbar "#a5adcb"

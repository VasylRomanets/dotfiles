# Dawnfox

color-link default "#575279,#faf4ed"
color-link comment "#bdbfc9"
color-link identifier "#295e73"
color-link identifier.class "#ea9d34"
color-link identifier.var "#4c4769"
color-link constant "#b4637a"
color-link constant.number "#ea9d34"
color-link constant.string "#618774"
color-link constant.specialChar "#625c87"
color-link constant.string.url "#b7bdf8"
color-link statement "#907aa9"
color-link symbol.operator "#56949f"
color-link symbol.brackets "#4c4769"
color-link symbol.tag "#295e73"
color-link preproc "#4c4769"
color-link type "#907aa9"
color-link type.keyword "#907aa9"
color-link special "#295e73"
color-link underlined "#b7bdf8,underline"
color-link error "bold #4c4769"
color-link todo "bold #ea9d34"
color-link selection "#575279,#4c4769"
color-link hlsearch "#faf4ed,#56949f"
color-link statusline "#faf4ed,#908ba2"
color-link statusline.inactive "#bdbfc9,#f0eae6"
color-link tabbar "#908ba2,#f0eae6"
color-link tabbar.inactive "#bdbfc9,#f0eae6"
color-link gutter-error "#b4637a"
color-link gutter-warning "#ea9d34"
color-link line-number "#bdbfc9,#f0eae6"
color-link current-line-number "#575279,#f0eae6"
color-link diff-added "#618774"
color-link diff-modified "#ea9d34"
color-link diff-deleted "#b4637a"
color-link cursor-line "#ebe0df"
color-link color-column "#ebe0df"
color-link indent-char "#d6d0d3"
color-link scrollbar "#bdbfc9"

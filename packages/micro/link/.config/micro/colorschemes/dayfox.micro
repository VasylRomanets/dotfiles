# Dayfox

color-link default "#3d2b5a,#f6f2ee"
color-link comment "#aab0ad"
color-link identifier "#223d90"
color-link identifier.class "#ac5402"
color-link identifier.var "#302b5d"
color-link constant "#a5222f"
color-link constant.number "#ac5402"
color-link constant.string "#396847"
color-link constant.specialChar "#643f61"
color-link constant.string.url "#b7bdf8"
color-link statement "#6e33ce"
color-link symbol.operator "#287980"
color-link symbol.brackets "#302b5d"
color-link symbol.tag "#223d90"
color-link preproc "#302b5d"
color-link type "#6e33ce"
color-link type.keyword "#6e33ce"
color-link special "#223d90"
color-link underlined "#b7bdf8,underline"
color-link error "bold #302b5d"
color-link todo "bold #ac5402"
color-link selection "#3d2b5a,#302b5d"
color-link hlsearch "#f6f2ee,#287980"
color-link statusline "#f6f2ee,#7e718e"
color-link statusline.inactive "#aab0ad,#ebe6e5"
color-link tabbar "#7e718e,#ebe6e5"
color-link tabbar.inactive "#aab0ad,#ebe6e5"
color-link gutter-error "#a5222f"
color-link gutter-warning "#ac5402"
color-link line-number "#aab0ad,#ebe6e5"
color-link current-line-number "#3d2b5a,#ebe6e5"
color-link diff-added "#396847"
color-link diff-modified "#ac5402"
color-link diff-deleted "#a5222f"
color-link cursor-line "#dbd1dd"
color-link color-column "#dbd1dd"
color-link indent-char "#cdc6cd"
color-link scrollbar "#aab0ad"

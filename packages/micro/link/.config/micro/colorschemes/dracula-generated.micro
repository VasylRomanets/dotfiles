# Dracula

color-link default "#f8f8f2,#282a36"
color-link comment "#6272a4"
color-link identifier "#50fa7b"
color-link identifier.class "#8be9fd"
color-link identifier.var "#f8f8f2"
color-link constant "#ffb86c"
color-link constant.number "#ffb86c"
color-link constant.string "#f1fa8c"
color-link constant.specialChar "#f1fa8c"
color-link constant.string.url "#8be9fd"
color-link statement "#ff79c6"
color-link symbol.operator "#f8f8f2"
color-link symbol.brackets "#f8f8f2"
color-link symbol.tag "#8be9fd"
color-link preproc "#f8f8f2"
color-link type "#ff79c6"
color-link type.keyword "#ff79c6"
color-link special "#8be9fd"
color-link underlined "#8be9fd,underline"
color-link error "bold #ff5555"
color-link todo "bold #f1fa8c"
color-link selection "#f8f8f2,#44475a"
color-link hlsearch "#282a36,#bd93f9"
color-link statusline "#282a36,#afb0b0"
color-link statusline.inactive "#6272a4,#21222c"
color-link tabbar "#afb0b0,#21222c"
color-link tabbar.inactive "#6272a4,#21222c"
color-link gutter-error "#ff5555"
color-link gutter-warning "#f1fa8c"
color-link line-number "#6272a4,#21222c"
color-link current-line-number "#f8f8f2,#21222c"
color-link diff-added "#50fa7b"
color-link diff-modified "#f1fa8c"
color-link diff-deleted "#ff5555"
color-link cursor-line "#353747"
color-link color-column "#353747"
color-link indent-char "#56575f"
color-link scrollbar "#6272a4"

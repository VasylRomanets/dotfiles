# Duskfox
# https://github.com/EdenEast/nightfox.nvim

color-link default "#E0DEF4,#232136"
color-link comment "#817C9C"
color-link identifier "#9CCFD8"
color-link constant "#F0A4A2"
color-link constant.number "#EA9A97"
color-link constant.string "#A3BE8C"
color-link constant.string.url "#65B1CD"
color-link statement "#C4A7E7"
color-link symbol.operator "#CDCBE0"
color-link preproc "#F0A6CC"
color-link type "#F6C177"
color-link special "#F0A4A2"
color-link underlined "#65B1CD,underline"
color-link error "bold #EB6F92"
color-link todo "bold #F6C177"
color-link selection "#EAE8FF,#433C59"
color-link statusline "#232136,#A3BE8C"
color-link statusline.inactive "#6E6A86,#2D2A45"
color-link tabbar "#232136,#2D2A45"
color-link tabbar.inactive "#6E6A86,#2D2A45"
color-link gutter-error "#EB6F92"
color-link gutter-warning "#F6C177"
color-link line-number "#6E6A86,#2D2A45"
color-link current-line-number "#E0DEF4,#2D2A45"
color-link diff-added "#A3BE8C"
color-link diff-modified "#F6C177"
color-link diff-deleted "#EB6F92"

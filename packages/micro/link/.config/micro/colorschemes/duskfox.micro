# Duskfox

color-link default "#e0def4,#232136"
color-link comment "#817c9c"
color-link identifier "#65b1cd"
color-link identifier.class "#f6c177"
color-link identifier.var "#e0def4"
color-link constant "#f0a4a2"
color-link constant.number "#ea9a97"
color-link constant.string "#a3be8c"
color-link constant.specialChar "#f083a2"
color-link constant.string.url "#e0def4"
color-link statement "#c4a7e7"
color-link symbol.operator "#c4a7e7"
color-link symbol.brackets "#e0def4"
color-link symbol.tag "#9ccfd8"
color-link preproc "#e0def4"
color-link type "#f6c177"
color-link type.keyword "#f6c177"
color-link special "#9ccfd8"
color-link underlined "#e0def4,underline"
color-link error "bold #f083a2"
color-link todo "bold #f6c177"
color-link selection "#e0def4,#433c59"
color-link hlsearch "#232136,#65b1cd"
color-link statusline "#232136,#9e9cb2"
color-link statusline.inactive "#817c9c,#2e2c41"
color-link tabbar "#9e9cb2,#2e2c41"
color-link tabbar.inactive "#817c9c,#2e2c41"
color-link gutter-error "#eb6f92"
color-link gutter-warning "#f6c177"
color-link line-number "#817c9c,#2e2c41"
color-link current-line-number "#e0def4,#2e2c41"
color-link diff-added "#a3be8c"
color-link diff-modified "#f6c177"
color-link diff-deleted "#eb6f92"
color-link cursor-line "#373354"
color-link color-column "#373354"
color-link indent-char "#4d4b60"
color-link scrollbar "#817c9c"

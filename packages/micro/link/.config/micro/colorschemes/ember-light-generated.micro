# Ember Light

color-link default "#282418,#e6dac4"
color-link comment "#787060"
color-link identifier "#7a6820"
color-link identifier.class "#7a6820"
color-link identifier.var "#282418"
color-link constant "#b84c30"
color-link constant.number "#946030"
color-link constant.string "#4a6830"
color-link constant.specialChar "#905050"
color-link constant.string.url "#282418"
color-link statement "#b84c30"
color-link symbol.operator "#b84c30"
color-link symbol.brackets "#282418"
color-link symbol.tag "#386858"
color-link preproc "#282418"
color-link type "#7a6820"
color-link type.keyword "#7a6820"
color-link special "#386858"
color-link underlined "#282418,underline"
color-link error "bold #905050"
color-link todo "bold #7a6820"
color-link selection "#282418,#b8ac96"
color-link hlsearch "#e6dac4,#7a6820"
color-link statusline "#e6dac4,#6a6454"
color-link statusline.inactive "#787060,#dbcfba"
color-link tabbar "#6a6454,#dbcfba"
color-link tabbar.inactive "#787060,#dbcfba"
color-link gutter-error "#b84c30"
color-link gutter-warning "#7a6820"
color-link line-number "#787060,#dbcfba"
color-link current-line-number "#282418,#dbcfba"
color-link diff-added "#4a6830"
color-link diff-modified "#7a6820"
color-link diff-deleted "#b84c30"
color-link cursor-line "#ddd0b8"
color-link color-column "#ddd0b8"
color-link indent-char "#bcb29e"
color-link scrollbar "#787060"

# Ember Light
# https://github.com/ember-theme/ember

color-link default "#282418,#e6dac4"
color-link comment "#787060"
color-link identifier "#585040"
color-link constant "#946030"
color-link constant.number "#946030"
color-link constant.string "#4a6830"
color-link constant.string.url "#3a6080"
color-link statement "#b84c30"
color-link symbol.operator "#787060"
color-link preproc "#b84c30"
color-link type "#7a6820"
color-link special "#706070"
color-link underlined "#3a6080,underline"
color-link error "bold #b84c30"
color-link todo "bold #7a6820"
color-link selection "#282418,#ddd0b8"
color-link statusline "#e6dac4,#585040"
color-link statusline.inactive "#787060,#ddd0b8"
color-link tabbar "#e6dac4,#ddd0b8"
color-link tabbar.inactive "#787060,#ddd0b8"
color-link gutter-error "#b84c30"
color-link gutter-warning "#7a6820"
color-link line-number "#787060,#ddd0b8"
color-link current-line-number "#282418,#ddd0b8"
color-link diff-added "#4a6830"
color-link diff-modified "#7a6820"
color-link diff-deleted "#b84c30"

# Ember Soft

color-link default "#d8d0c0,#242320"
color-link comment "#706c61"
color-link identifier "#c8b468"
color-link identifier.class "#c8b468"
color-link identifier.var "#d8d0c0"
color-link constant "#e08060"
color-link constant.number "#c09058"
color-link constant.string "#8a9868"
color-link constant.specialChar "#b07878"
color-link constant.string.url "#d8d0c0"
color-link statement "#e08060"
color-link symbol.operator "#e08060"
color-link symbol.brackets "#d8d0c0"
color-link symbol.tag "#80a090"
color-link preproc "#d8d0c0"
color-link type "#c8b468"
color-link type.keyword "#c8b468"
color-link special "#80a090"
color-link underlined "#d8d0c0,underline"
color-link error "bold #b07878"
color-link todo "bold #c8b468"
color-link selection "#d8d0c0,#444240"
color-link hlsearch "#242320,#c8b468"
color-link statusline "#242320,#999388"
color-link statusline.inactive "#706c61,#2f2d2a"
color-link tabbar "#999388,#2f2d2a"
color-link tabbar.inactive "#706c61,#2f2d2a"
color-link gutter-error "#e08060"
color-link gutter-warning "#c8b468"
color-link line-number "#706c61,#2f2d2a"
color-link current-line-number "#d8d0c0,#2f2d2a"
color-link diff-added "#8a9868"
color-link diff-modified "#c8b468"
color-link diff-deleted "#e08060"
color-link cursor-line "#2a2927"
color-link color-column "#2a2927"
color-link indent-char "#4c4943"
color-link scrollbar "#706c61"

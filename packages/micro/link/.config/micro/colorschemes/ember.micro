# Ember
# https://github.com/ember-theme/ember

color-link default "#d8d0c0,#1c1b19"
color-link comment "#706c61"
color-link identifier "#b0a898"
color-link constant "#c09058"
color-link constant.number "#c09058"
color-link constant.string "#8a9868"
color-link constant.string.url "#7890a0"
color-link statement "#e08060"
color-link symbol.operator "#706c61"
color-link preproc "#e08060"
color-link type "#c8b468"
color-link special "#988090"
color-link underlined "#7890a0,underline"
color-link error "bold #e08060"
color-link todo "bold #c8b468"
color-link selection "#d8d0c0,#242320"
color-link statusline "#1c1b19,#b0a898"
color-link statusline.inactive "#706c61,#242320"
color-link tabbar "#1c1b19,#242320"
color-link tabbar.inactive "#706c61,#242320"
color-link gutter-error "#e08060"
color-link gutter-warning "#c8b468"
color-link line-number "#706c61,#242320"
color-link current-line-number "#d8d0c0,#242320"
color-link diff-added "#8a9868"
color-link diff-modified "#c8b468"
color-link diff-deleted "#e08060"

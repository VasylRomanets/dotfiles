# Ethereal

color-link default "#ffcead,#060b1e"
color-link comment "#6d7db6"
color-link identifier "#7d82d9"
color-link identifier.class "#e9bb4f"
color-link identifier.var "#ed5b5a"
color-link constant "#faaaa9"
color-link constant.number "#faaaa9"
color-link constant.string "#92a593"
color-link constant.specialChar "#a3bfd1"
color-link constant.string.url "#ffcead"
color-link statement "#c89dc1"
color-link symbol.operator "#c89dc1"
color-link symbol.brackets "#ffcead"
color-link symbol.tag "#ed5b5a"
color-link preproc "#ffcead"
color-link type "#e9bb4f"
color-link type.keyword "#e9bb4f"
color-link special "#ed5b5a"
color-link underlined "#ffcead,underline"
color-link error "bold #ed5b5a"
color-link todo "bold #e9bb4f"
color-link selection "#ffcead,#252e56"
color-link hlsearch "#060b1e,#7d82d9"
color-link statusline "#060b1e,#a88a7b"
color-link statusline.inactive "#6d7db6,#151727"
color-link tabbar "#a88a7b,#151727"
color-link tabbar.inactive "#6d7db6,#151727"
color-link gutter-error "#ed5b5a"
color-link gutter-warning "#e9bb4f"
color-link line-number "#6d7db6,#151727"
color-link current-line-number "#ffcead,#151727"
color-link diff-added "#92a593"
color-link diff-modified "#e9bb4f"
color-link diff-deleted "#ed5b5a"
color-link cursor-line "#151727"
color-link color-column "#151727"
color-link indent-char "#3d363d"
color-link scrollbar "#6d7db6"

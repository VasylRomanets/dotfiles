# Flexoki Dark

color-link default "#cecdc3,#100f0f"
color-link comment "#575653"
color-link identifier "#da702c"
color-link identifier.class "#879a39"
color-link identifier.var "#4385be"
color-link constant "#ce5d97"
color-link constant.number "#8b7ec8"
color-link constant.string "#3aa99f"
color-link constant.specialChar "#ce5d97"
color-link constant.string.url "#4385be"
color-link statement "#879a39"
color-link symbol.operator "#878580"
color-link symbol.brackets "#878580"
color-link symbol.tag "#3aa99f"
color-link preproc "#ce5d97"
color-link type "#da702c"
color-link type.keyword "#da702c"
color-link special "#3aa99f"
color-link underlined "#4385be,underline"
color-link error "bold #d14d41"
color-link todo "bold #d0a215"
color-link selection "#cecdc3,#403e3c"
color-link hlsearch "#100f0f,#3aa99f"
color-link statusline "#100f0f,#8c8a84"
color-link statusline.inactive "#575653,#1b1a1a"
color-link tabbar "#8c8a84,#1b1a1a"
color-link tabbar.inactive "#575653,#1b1a1a"
color-link gutter-error "#d14d41"
color-link gutter-warning "#d0a215"
color-link line-number "#575653,#1b1a1a"
color-link current-line-number "#cecdc3,#1b1a1a"
color-link diff-added "#879a39"
color-link diff-modified "#d0a215"
color-link diff-deleted "#d14d41"
color-link cursor-line "#282726"
color-link color-column "#282726"
color-link indent-char "#3a3937"
color-link scrollbar "#575653"

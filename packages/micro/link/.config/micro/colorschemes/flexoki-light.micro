# Flexoki Light

color-link default "#100f0f,#fffcf0"
color-link comment "#b7b5ac"
color-link identifier "#bc5215"
color-link identifier.class "#66800b"
color-link identifier.var "#205ea6"
color-link constant "#a02f6f"
color-link constant.number "#5e409d"
color-link constant.string "#24837b"
color-link constant.specialChar "#a02f6f"
color-link constant.string.url "#205ea6"
color-link statement "#66800b"
color-link symbol.operator "#6f6e69"
color-link symbol.brackets "#6f6e69"
color-link symbol.tag "#24837b"
color-link preproc "#a02f6f"
color-link type "#bc5215"
color-link type.keyword "#bc5215"
color-link special "#24837b"
color-link underlined "#205ea6,underline"
color-link error "bold #af3029"
color-link todo "bold #ad8301"
color-link selection "#100f0f,#cecdc3"
color-link hlsearch "#fffcf0,#24837b"
color-link statusline "#fffcf0,#64625e"
color-link statusline.inactive "#b7b5ac,#f1eee2"
color-link tabbar "#64625e,#f1eee2"
color-link tabbar.inactive "#b7b5ac,#f1eee2"
color-link gutter-error "#af3029"
color-link gutter-warning "#ad8301"
color-link line-number "#b7b5ac,#f1eee2"
color-link current-line-number "#100f0f,#f1eee2"
color-link diff-added "#66800b"
color-link diff-modified "#ad8301"
color-link diff-deleted "#af3029"
color-link cursor-line "#e6e4d9"
color-link color-column "#e6e4d9"
color-link indent-char "#cac8bf"
color-link scrollbar "#b7b5ac"

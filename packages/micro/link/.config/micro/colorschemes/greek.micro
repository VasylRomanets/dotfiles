# Greek

color-link default "#242424,#d0d0c8"
color-link comment "#57574c"
color-link identifier "#36597c"
color-link identifier.class "#943a17"
color-link identifier.var "#a22824"
color-link constant "#a22824"
color-link constant.number "#a22824"
color-link constant.string "#3c5f34"
color-link constant.specialChar "#146061"
color-link constant.string.url "#242424"
color-link statement "#614c84"
color-link symbol.operator "#614c84"
color-link symbol.brackets "#242424"
color-link symbol.tag "#a22824"
color-link preproc "#242424"
color-link type "#943a17"
color-link type.keyword "#943a17"
color-link special "#a22824"
color-link underlined "#242424,underline"
color-link error "bold #a22824"
color-link todo "bold #953b19"
color-link selection "#242424,#dfddeb"
color-link hlsearch "#d0d0c8,#de6a41"

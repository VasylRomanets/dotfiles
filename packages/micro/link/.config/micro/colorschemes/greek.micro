color-link statusline.inactive "#57574c,#c6c6be"
color-link tabbar "#60605d,#c6c6be"
color-link tabbar.inactive "#57574c,#c6c6be"
color-link gutter-error "#a32a26"
color-link gutter-warning "#953b19"

# Hackerman

color-link default "#ddf7ff,#0b0c16"
color-link comment "#6a6e95"
color-link identifier "#829dd4"
color-link identifier.class "#50f7d4"
color-link identifier.var "#31f759"
color-link constant "#85ff9d"
color-link constant.number "#85ff9d"
color-link constant.string "#4fe88f"
color-link constant.specialChar "#7cf8f7"
color-link constant.string.url "#ddf7ff"
color-link statement "#86a7df"
color-link symbol.operator "#86a7df"
color-link symbol.brackets "#ddf7ff"
color-link symbol.tag "#31f759"
color-link preproc "#ddf7ff"
color-link type "#50f7d4"
color-link type.keyword "#50f7d4"
color-link special "#31f759"
color-link underlined "#ddf7ff,underline"
color-link error "bold #31f759"
color-link todo "bold #50f7d4"
color-link selection "#ddf7ff,#1f253a"
color-link hlsearch "#0b0c16,#82fb9c"
color-link statusline "#0b0c16,#94a5ad"
color-link statusline.inactive "#6a6e95,#181a24"
color-link tabbar "#94a5ad,#181a24"
color-link tabbar.inactive "#6a6e95,#181a24"
color-link gutter-error "#50f872"
color-link gutter-warning "#50f7d4"
color-link line-number "#6a6e95,#181a24"
color-link current-line-number "#ddf7ff,#181a24"
color-link diff-added "#4fe88f"
color-link diff-modified "#50f7d4"
color-link diff-deleted "#50f872"
color-link cursor-line "#181a24"
color-link color-column "#181a24"
color-link indent-char "#394049"
color-link scrollbar "#6a6e95"

# Harbor Dark

color-link default "#efebdc,#1b1b1b"
color-link comment "#87856d"
color-link identifier "#9ba2a6"
color-link identifier.class "#efebdc"
color-link identifier.var "#efebdc"
color-link constant "#e75a50"
color-link constant.number "#87856d"
color-link constant.string "#a99b7a"
color-link constant.specialChar "#9683a1"
color-link constant.string.url "#efebdc"
color-link statement "#9683a1"
color-link symbol.operator "#9ba2a6"
color-link symbol.brackets "#a99b7a"
color-link symbol.tag "#e1ce98"
color-link preproc "#efebdc"
color-link type "#e1ce98"
color-link type.keyword "#e1ce98"
color-link special "#e1ce98"
color-link underlined "#efebdc,underline"
color-link error "bold #f44336"
color-link todo "bold #e1ce98"
color-link selection "#efebdc,#68332f"
color-link hlsearch "#1b1b1b,#e75a50"
color-link statusline "#1b1b1b,#a5a298"
color-link statusline.inactive "#87856d,#282727"
color-link tabbar "#a5a298,#282727"
color-link tabbar.inactive "#87856d,#282727"
color-link gutter-error "#f44336"
color-link gutter-warning "#e1ce98"
color-link line-number "#87856d,#282727"
color-link current-line-number "#efebdc,#282727"
color-link diff-added "#a99b7a"
color-link diff-modified "#e1ce98"
color-link diff-deleted "#f44336"
color-link cursor-line "#262626"
color-link color-column "#262626"
color-link indent-char "#4a4945"
color-link scrollbar "#87856d"

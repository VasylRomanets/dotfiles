# Harbor Light

color-link default "#1c2d28,#dfe4c4"
color-link comment "#727d8a"
color-link identifier "#476489"
color-link identifier.class "#d05734"
color-link identifier.var "#a4424c"
color-link constant "#a4424c"
color-link constant.number "#a4424c"
color-link constant.string "#556753"
color-link constant.specialChar "#316a7b"
color-link constant.string.url "#384f54"
color-link statement "#7f5578"
color-link symbol.operator "#7f5578"
color-link symbol.brackets "#384f54"
color-link symbol.tag "#a4424c"
color-link preproc "#384f54"
color-link type "#d05734"
color-link type.keyword "#d05734"
color-link special "#a4424c"
color-link underlined "#384f54,underline"
color-link error "bold #a4424c"
color-link todo "bold #dc8164"
color-link selection "#1c2d28,#c8d4a8"
color-link hlsearch "#dfe4c4,#5e81ac"
color-link statusline "#dfe4c4,#606d5f"
color-link statusline.inactive "#727d8a,#d3d9bb"
color-link tabbar "#606d5f,#d3d9bb"
color-link tabbar.inactive "#727d8a,#d3d9bb"
color-link gutter-error "#b14752"
color-link gutter-warning "#dc8164"
color-link line-number "#727d8a,#d3d9bb"
color-link current-line-number "#1c2d28,#d3d9bb"
color-link diff-added "#556753"
color-link diff-modified "#dc8164"
color-link diff-deleted "#b14752"
color-link cursor-line "#d5dab8"
color-link color-column "#d5dab8"
color-link indent-char "#b4bca2"
color-link scrollbar "#727d8a"

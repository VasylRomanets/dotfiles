# Inky Pinky

color-link default "#c8c8c8,#13131d"
color-link comment "#616177"
color-link identifier "#7c7ca8"
color-link identifier.class "#d18ba2"
color-link identifier.var "#ea90a8"
color-link constant "#f6bfce"
color-link constant.number "#f6bfce"
color-link constant.string "#a6b2c7"
color-link constant.specialChar "#f6bfce"
color-link constant.string.url "#ea90a8"
color-link statement "#9f859f"
color-link symbol.operator "#9f859f"
color-link symbol.brackets "#c8c8c8"
color-link symbol.tag "#ea90a8"
color-link preproc "#c8c8c8"
color-link type "#9f859f"
color-link type.keyword "#9f859f"
color-link special "#ea90a8"
color-link underlined "#ea90a8,underline"
color-link error "bold #ea90a8"
color-link todo "bold #d18ba2"
color-link selection "#c8c8c8,#2c293f"
color-link hlsearch "#13131d,#7c7ca8"
color-link statusline "#13131d,#89898c"
color-link statusline.inactive "#616177,#1e1e27"
color-link tabbar "#89898c,#1e1e27"
color-link tabbar.inactive "#616177,#1e1e27"
color-link gutter-error "#ea90a8"
color-link gutter-warning "#d18ba2"
color-link line-number "#616177,#1e1e27"
color-link current-line-number "#c8c8c8,#1e1e27"
color-link diff-added "#a6b2c7"
color-link diff-modified "#d18ba2"
color-link diff-deleted "#ea90a8"
color-link cursor-line "#222030"
color-link color-column "#222030"
color-link indent-char "#3b3b43"
color-link scrollbar "#616177"

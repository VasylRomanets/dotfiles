# Jellybeans HC Light

color-link default "#000000,#fafafa"
color-link comment "#707070"
color-link identifier "#7a5000"
color-link identifier.class "#8a5000"
color-link identifier.var "#000000"
color-link constant "#8a3a10"
color-link constant.number "#8a3a10"
color-link constant.string "#507020"
color-link constant.specialChar "#8a3a10"
color-link constant.string.url "#0a3a8a"
color-link statement "#0a4a7a"
color-link symbol.operator "#0a3a8a"
color-link symbol.brackets "#306070"
color-link symbol.tag "#0a4a7a"
color-link preproc "#000000"
color-link type "#1a3a80"
color-link type.keyword "#1a3a80"
color-link special "#0a4a7a"
color-link underlined "#0a3a8a,underline"
color-link error "bold #c00000"
color-link todo "bold #7a5000"
color-link selection "#000000,#e8d0c0"
color-link hlsearch "#fafafa,#0a3a8a"
color-link statusline "#fafafa,#585858"
color-link statusline.inactive "#707070,#ebebeb"
color-link tabbar "#585858,#ebebeb"
color-link tabbar.inactive "#707070,#ebebeb"
color-link gutter-error "#c00000"
color-link gutter-warning "#7a5000"
color-link line-number "#707070,#ebebeb"
color-link current-line-number "#000000,#ebebeb"
color-link diff-added "#507020"
color-link diff-modified "#7a5000"
color-link diff-deleted "#c00000"
color-link cursor-line "#ebebeb"
color-link color-column "#ebebeb"
color-link indent-char "#c3c3c3"
color-link scrollbar "#707070"

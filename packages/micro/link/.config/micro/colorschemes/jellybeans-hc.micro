# Jellybeans HC

color-link default "#f8f8f0,#060606"
color-link comment "#909090"
color-link identifier "#ffe080"
color-link identifier.class "#ffc060"
color-link identifier.var "#f8f8f0"
color-link constant "#f0a080"
color-link constant.number "#f0a080"
color-link constant.string "#c0d880"
color-link constant.specialChar "#f0a080"
color-link constant.string.url "#c0e0ff"
color-link statement "#aad4f8"
color-link symbol.operator "#c0e0ff"
color-link symbol.brackets "#78a0b8"
color-link symbol.tag "#aad4f8"
color-link preproc "#f8f8f0"
color-link type "#98b0e0"
color-link type.keyword "#98b0e0"
color-link special "#aad4f8"
color-link underlined "#c0e0ff,underline"
color-link error "bold #ff5050"
color-link todo "bold #ffe080"
color-link selection "#f8f8f0,#303030"
color-link hlsearch "#060606,#c0e0ff"
color-link statusline "#060606,#a3a39e"
color-link statusline.inactive "#909090,#151514"
color-link tabbar "#a3a39e,#151514"
color-link tabbar.inactive "#909090,#151514"
color-link gutter-error "#ff5050"
color-link gutter-warning "#ffe080"
color-link line-number "#909090,#151514"
color-link current-line-number "#f8f8f0,#151514"
color-link diff-added "#c0d880"
color-link diff-modified "#ffe080"
color-link diff-deleted "#ff5050"
color-link cursor-line "#151514"
color-link color-column "#151514"
color-link indent-char "#3b3b39"
color-link scrollbar "#909090"

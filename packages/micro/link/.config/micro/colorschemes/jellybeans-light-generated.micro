# Jellybeans Light

color-link default "#252525,#f5e6d3"
color-link comment "#787878"
color-link identifier "#876820"
color-link identifier.class "#b87520"
color-link identifier.var "#252525"
color-link constant "#954d3b"
color-link constant.number "#954d3b"
color-link constant.string "#658349"
color-link constant.specialChar "#954d3b"
color-link constant.string.url "#234291"
color-link statement "#2b5b77"
color-link symbol.operator "#234291"
color-link symbol.brackets "#3a596a"
color-link symbol.tag "#2b5b77"
color-link preproc "#252525"
color-link type "#2952a3"
color-link type.keyword "#2952a3"
color-link special "#2b5b77"
color-link underlined "#234291,underline"
color-link error "bold #ff3333"
color-link todo "bold #876820"
color-link selection "#252525,#d7af87"
color-link hlsearch "#f5e6d3,#234291"
color-link statusline "#f5e6d3,#6e6962"
color-link statusline.inactive "#787878,#e9dac9"
color-link tabbar "#6e6962,#e9dac9"
color-link tabbar.inactive "#787878,#e9dac9"
color-link gutter-error "#ff3333"
color-link gutter-warning "#876820"
color-link line-number "#787878,#e9dac9"
color-link current-line-number "#252525,#e9dac9"
color-link diff-added "#386014"
color-link diff-modified "#876820"
color-link diff-deleted "#ff3333"
color-link cursor-line "#e9dac9"
color-link color-column "#e9dac9"
color-link indent-char "#c7bcad"
color-link scrollbar "#787878"

# Jellybeans Mono Light

color-link default "#252525,#f5f0e8"
color-link comment "#787878"
color-link identifier "#7d7163"
color-link identifier.class "#707070"
color-link identifier.var "#252525"
color-link constant "#645c54"
color-link constant.number "#645c54"
color-link constant.string "#7d7163"
color-link constant.specialChar "#645c54"
color-link constant.string.url "#4a5e81"
color-link statement "#4a5e81"
color-link symbol.operator "#4a5e81"
color-link symbol.brackets "#576270"
color-link symbol.tag "#4a5e81"
color-link preproc "#252525"
color-link type "#4a5e81"
color-link type.keyword "#4a5e81"
color-link special "#4a5e81"
color-link underlined "#4a5e81,underline"
color-link error "bold #cc0000"
color-link todo "bold #6a6564"
color-link selection "#252525,#d8c8b8"
color-link hlsearch "#f5f0e8,#4a5e81"
color-link statusline "#f5f0e8,#6e6c69"
color-link statusline.inactive "#787878,#e9e4dc"
color-link tabbar "#6e6c69,#e9e4dc"
color-link tabbar.inactive "#787878,#e9e4dc"
color-link gutter-error "#cc0000"
color-link gutter-warning "#6a6564"
color-link line-number "#787878,#e9e4dc"
color-link current-line-number "#252525,#e9e4dc"
color-link diff-added "#7d7163"
color-link diff-modified "#6a6564"
color-link diff-deleted "#cc0000"
color-link cursor-line "#e9e4dc"
color-link color-column "#e9e4dc"
color-link indent-char "#c7c3bd"
color-link scrollbar "#787878"

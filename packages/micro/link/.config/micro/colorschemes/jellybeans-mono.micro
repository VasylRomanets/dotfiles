# Jellybeans Mono

color-link default "#e8e8d3,#151515"
color-link comment "#888888"
color-link identifier "#b39066"
color-link identifier.class "#888888"
color-link identifier.var "#e8e8d3"
color-link constant "#a0a8b0"
color-link constant.number "#a0a8b0"
color-link constant.string "#b39066"
color-link constant.specialChar "#a0a8b0"
color-link constant.string.url "#7a8aa6"
color-link statement "#7a8aa6"
color-link symbol.operator "#7a8aa6"
color-link symbol.brackets "#556779"
color-link symbol.tag "#7a8aa6"
color-link preproc "#e8e8d3"
color-link type "#7a8aa6"
color-link type.keyword "#7a8aa6"
color-link special "#7a8aa6"
color-link underlined "#7a8aa6,underline"
color-link error "bold #c95c5c"
color-link todo "bold #ccc5c4"
color-link selection "#e8e8d3,#404040"
color-link hlsearch "#151515,#7a8aa6"
color-link statusline "#151515,#9e9e90"
color-link statusline.inactive "#888888,#222220"
color-link tabbar "#9e9e90,#222220"
color-link tabbar.inactive "#888888,#222220"
color-link gutter-error "#c95c5c"
color-link gutter-warning "#ccc5c4"
color-link line-number "#888888,#222220"
color-link current-line-number "#e8e8d3,#222220"
color-link diff-added "#b39066"
color-link diff-modified "#ccc5c4"
color-link diff-deleted "#c95c5c"
color-link cursor-line "#222220"
color-link color-column "#222220"
color-link indent-char "#43433f"
color-link scrollbar "#888888"

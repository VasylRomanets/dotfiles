# Jellybeans Muted

color-link default "#dad6c8,#101010"
color-link comment "#7a7a7a"
color-link identifier "#e8c88c"
color-link identifier.class "#d8a16c"
color-link identifier.var "#dad6c8"
color-link constant "#c88a77"
color-link constant.number "#c88a77"
color-link constant.string "#909c6e"
color-link constant.specialChar "#c88a77"
color-link constant.string.url "#a6c3d9"
color-link statement "#83adc3"
color-link symbol.operator "#a6c3d9"
color-link symbol.brackets "#617b87"
color-link symbol.tag "#83adc3"
color-link preproc "#dad6c8"
color-link type "#7a8aa6"
color-link type.keyword "#7a8aa6"
color-link special "#83adc3"
color-link underlined "#a6c3d9,underline"
color-link error "bold #cc4d4d"
color-link todo "bold #e8c88c"
color-link selection "#dad6c8,#3c3b38"
color-link hlsearch "#101010,#a6c3d9"
color-link statusline "#101010,#939188"
color-link statusline.inactive "#7a7a7a,#1c1c1b"
color-link tabbar "#939188,#1c1c1b"
color-link tabbar.inactive "#7a7a7a,#1c1c1b"
color-link gutter-error "#cc4d4d"
color-link gutter-warning "#e8c88c"
color-link line-number "#7a7a7a,#1c1c1b"
color-link current-line-number "#dad6c8,#1c1c1b"
color-link diff-added "#909c6e"
color-link diff-modified "#e8c88c"
color-link diff-deleted "#cc4d4d"
color-link cursor-line "#1c1c1b"
color-link color-column "#1c1c1b"
color-link indent-char "#3c3c38"
color-link scrollbar "#7a7a7a"

# Jellybeans Muted Light

color-link default "#2d2c2a,#f7f3eb"
color-link comment "#787775"
color-link identifier "#987b40"
color-link identifier.class "#a07542"
color-link identifier.var "#2d2c2a"
color-link constant "#8c594a"
color-link constant.number "#8c594a"
color-link constant.string "#6d7f59"
color-link constant.specialChar "#8c594a"
color-link constant.string.url "#334a84"
color-link statement "#3c5971"
color-link symbol.operator "#334a84"
color-link symbol.brackets "#475b68"
color-link symbol.tag "#3c5971"
color-link preproc "#2d2c2a"
color-link type "#445987"
color-link type.keyword "#445987"
color-link special "#3c5971"
color-link underlined "#334a84,underline"
color-link error "bold #b84949"
color-link todo "bold #987b40"
color-link selection "#2d2c2a,#c9b99a"
color-link hlsearch "#f7f3eb,#334a84"
color-link statusline "#f7f3eb,#74726e"
color-link statusline.inactive "#787775,#ebe7df"
color-link tabbar "#74726e,#ebe7df"
color-link tabbar.inactive "#787775,#ebe7df"
color-link gutter-error "#b84949"
color-link gutter-warning "#987b40"
color-link line-number "#787775,#ebe7df"
color-link current-line-number "#2d2c2a,#ebe7df"
color-link diff-added "#6d7f59"
color-link diff-modified "#987b40"
color-link diff-deleted "#b84949"
color-link cursor-line "#ebe7df"
color-link color-column "#ebe7df"
color-link indent-char "#cbc7c1"
color-link scrollbar "#787775"

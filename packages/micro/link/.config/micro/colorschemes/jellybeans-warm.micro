# Jellybeans Warm

color-link default "#edd9b8,#1c1510"
color-link comment "#8a8070"
color-link identifier "#fad07a"
color-link identifier.class "#e6a75a"
color-link identifier.var "#edd9b8"
color-link constant "#d98870"
color-link constant.number "#d98870"
color-link constant.string "#99ad6a"
color-link constant.specialChar "#d98870"
color-link constant.string.url "#c8b878"
color-link statement "#8fbfdc"
color-link symbol.operator "#c8b878"
color-link symbol.brackets "#668799"
color-link symbol.tag "#8fbfdc"
color-link preproc "#edd9b8"
color-link type "#8197bf"
color-link type.keyword "#8197bf"
color-link special "#8fbfdc"
color-link underlined "#c8b878,underline"
color-link error "bold #d74545"
color-link todo "bold #fad07a"
color-link selection "#edd9b8,#4a3828"
color-link hlsearch "#1c1510,#c8b878"
color-link statusline "#1c1510,#a4947d"
color-link statusline.inactive "#8a8070,#29211a"
color-link tabbar "#a4947d,#29211a"
color-link tabbar.inactive "#8a8070,#29211a"
color-link gutter-error "#d74545"
color-link gutter-warning "#fad07a"
color-link line-number "#8a8070,#29211a"
color-link current-line-number "#edd9b8,#29211a"
color-link diff-added "#99ad6a"
color-link diff-modified "#fad07a"
color-link diff-deleted "#d74545"
color-link cursor-line "#29211a"
color-link color-column "#29211a"
color-link indent-char "#4a4035"
color-link scrollbar "#8a8070"

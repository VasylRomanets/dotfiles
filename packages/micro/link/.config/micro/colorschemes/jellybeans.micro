# Jellybeans

color-link default "#e8e8d3,#151515"
color-link comment "#888888"
color-link identifier "#fad07a"
color-link identifier.class "#e6a75a"
color-link identifier.var "#e8e8d3"
color-link constant "#d98870"
color-link constant.number "#d98870"
color-link constant.string "#99ad6a"
color-link constant.specialChar "#d98870"
color-link constant.string.url "#b0d0f0"
color-link statement "#8fbfdc"
color-link symbol.operator "#b0d0f0"
color-link symbol.brackets "#668799"
color-link symbol.tag "#8fbfdc"
color-link preproc "#e8e8d3"
color-link type "#8197bf"
color-link type.keyword "#8197bf"
color-link special "#8fbfdc"
color-link underlined "#b0d0f0,underline"
color-link error "bold #d74545"
color-link todo "bold #fad07a"
color-link selection "#e8e8d3,#404040"
color-link hlsearch "#151515,#b0d0f0"
color-link statusline "#151515,#9e9e90"
color-link statusline.inactive "#888888,#222220"
color-link tabbar "#9e9e90,#222220"
color-link tabbar.inactive "#888888,#222220"
color-link gutter-error "#d74545"
color-link gutter-warning "#fad07a"
color-link line-number "#888888,#222220"
color-link current-line-number "#e8e8d3,#222220"
color-link diff-added "#99ad6a"
color-link diff-modified "#fad07a"
color-link diff-deleted "#d74545"
color-link cursor-line "#222220"
color-link color-column "#222220"
color-link indent-char "#43433f"
color-link scrollbar "#888888"

# Kanagawa Dragon

color-link default "#c5c9c5,#181616"
color-link comment "#737c73"
color-link identifier "#8ba4b0"
color-link identifier.class "#8ea4a2"
color-link identifier.var "#c4b28a"
color-link constant "#b6927b"
color-link constant.number "#a292a3"
color-link constant.string "#8a9a7b"
color-link constant.specialChar "#e82424"
color-link constant.string.url "#c5c9c5"
color-link statement "#8992a7"
color-link symbol.operator "#8992a7"
color-link symbol.brackets "#c5c9c5"
color-link symbol.tag "#8ba4b0"
color-link preproc "#c5c9c5"
color-link type "#8ea4a2"
color-link type.keyword "#8ea4a2"
color-link special "#8ba4b0"
color-link underlined "#c5c9c5,underline"
color-link error "bold #e82424"
color-link todo "bold #c4b28a"
color-link selection "#c5c9c5,#2d4f67"
color-link hlsearch "#181616,#8ba4b0"
color-link statusline "#181616,#888a88"
color-link statusline.inactive "#737c73,#222120"
color-link tabbar "#888a88,#222120"
color-link tabbar.inactive "#737c73,#222120"
color-link gutter-error "#c4746e"
color-link gutter-warning "#c4b28a"
color-link line-number "#737c73,#222120"
color-link current-line-number "#c5c9c5,#222120"
color-link diff-added "#8a9a7b"
color-link diff-modified "#c4b28a"
color-link diff-deleted "#c4746e"
color-link cursor-line "#2d4f67"
color-link color-column "#2d4f67"
color-link indent-char "#3e3d3c"
color-link scrollbar "#737c73"

# Kanagawa (Dragon)
# https://github.com/rebelot/kanagawa.nvim

color-link default "#c5c9c5,#181616"
color-link comment "#737c73"
color-link identifier "#c4b28a"
color-link constant "#8992a7"
color-link constant.number "#a292a3"
color-link constant.string "#8a9a7b"
color-link constant.string.url "#8ea4a2"
color-link statement "#8ba4b0"
color-link symbol.operator "#8992a7"
color-link preproc "#8992a7"
color-link type "#8ea4a2"
color-link special "#8992a7"
color-link underlined "#8ea4a2,underline"
color-link error "bold #a292a3"
color-link todo "bold #c4b28a"
color-link selection "#c5c9c5,#282727"
color-link statusline "#181616,#8ba4b0"
color-link statusline.inactive "#737c73,#282727"
color-link tabbar "#181616,#282727"
color-link tabbar.inactive "#737c73,#282727"
color-link gutter-error "#a292a3"
color-link gutter-warning "#c4b28a"
color-link line-number "#737c73,#282727"
color-link current-line-number "#c5c9c5,#282727"
color-link diff-added "#8a9a7b"
color-link diff-modified "#c4b28a"
color-link diff-deleted "#a292a3"

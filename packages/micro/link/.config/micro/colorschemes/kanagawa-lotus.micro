# Kanagawa Lotus

color-link default "#545464,#f2ecbc"
color-link comment "#8a8980"
color-link identifier "#4d699b"
color-link identifier.class "#597b75"
color-link identifier.var "#77713f"
color-link constant "#cc6d00"
color-link constant.number "#b35b79"
color-link constant.string "#6f894e"
color-link constant.specialChar "#e82424"
color-link constant.string.url "#545464"
color-link statement "#624c83"
color-link symbol.operator "#624c83"
color-link symbol.brackets "#545464"
color-link symbol.tag "#4d699b"
color-link preproc "#545464"
color-link type "#597b75"
color-link type.keyword "#597b75"
color-link special "#4d699b"
color-link underlined "#545464,underline"
color-link error "bold #e82424"
color-link todo "bold #77713f"
color-link selection "#545464,#b5cbd2"
color-link hlsearch "#f2ecbc,#4d699b"
color-link statusline "#f2ecbc,#8b8983"
color-link statusline.inactive "#8a8980,#e9e3b7"
color-link tabbar "#8b8983,#e9e3b7"
color-link tabbar.inactive "#8a8980,#e9e3b7"
color-link gutter-error "#c84053"
color-link gutter-warning "#77713f"
color-link line-number "#8a8980,#e9e3b7"
color-link current-line-number "#545464,#e9e3b7"
color-link diff-added "#6f894e"
color-link diff-modified "#77713f"
color-link diff-deleted "#c84053"
color-link cursor-line "#b5cbd2"
color-link color-column "#b5cbd2"
color-link indent-char "#cfcba9"
color-link scrollbar "#8a8980"

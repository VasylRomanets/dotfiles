# Kanagawa (Lotus)
# https://github.com/rebelot/kanagawa.nvim

color-link default "#545464,#f2ecbc"
color-link comment "#8a8980"
color-link identifier "#77713f"
color-link constant "#624c83"
color-link constant.number "#b35b79"
color-link constant.string "#6f894e"
color-link constant.string.url "#597b75"
color-link statement "#4d699b"
color-link symbol.operator "#624c83"
color-link preproc "#624c83"
color-link type "#597b75"
color-link special "#624c83"
color-link underlined "#597b75,underline"
color-link error "bold #b35b79"
color-link todo "bold #77713f"
color-link selection "#545464,#e7dba0"
color-link statusline "#f2ecbc,#4d699b"
color-link statusline.inactive "#8a8980,#e7dba0"
color-link tabbar "#f2ecbc,#e7dba0"
color-link tabbar.inactive "#8a8980,#e7dba0"
color-link gutter-error "#b35b79"
color-link gutter-warning "#77713f"
color-link line-number "#8a8980,#e7dba0"
color-link current-line-number "#545464,#e7dba0"
color-link diff-added "#6f894e"
color-link diff-modified "#77713f"
color-link diff-deleted "#b35b79"

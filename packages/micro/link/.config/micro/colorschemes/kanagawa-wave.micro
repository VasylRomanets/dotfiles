# Kanagawa Wave
# https://github.com/rebelot/kanagawa.nvim

color-link default "#dcd7ba,#1f1f28"
color-link comment "#727169"
color-link identifier "#dcd7ba"
color-link constant "#c0a36e"
color-link constant.number "#c0a36e"
color-link constant.string "#76946a"
color-link constant.string.url "#6a9589"
color-link statement "#c34043"
color-link symbol.operator "#6a9589"
color-link preproc "#957fb8"
color-link type "#c0a36e"
color-link special "#e6c384"
color-link underlined "#6a9589,underline"
color-link error "bold #e82424"
color-link todo "bold #e6c384"
color-link selection "#dcd7ba,#2d4f67"
color-link statusline "#1f1f28,#76946a"
color-link statusline.inactive "#727169,#2a2a31"
color-link tabbar "#1f1f28,#2a2a31"
color-link tabbar.inactive "#727169,#2a2a31"
color-link gutter-error "#e82424"
color-link gutter-warning "#c0a36e"
color-link line-number "#727169,#2a2a31"
color-link current-line-number "#dcd7ba,#2a2a31"
color-link diff-added "#76946a"
color-link diff-modified "#c0a36e"
color-link diff-deleted "#c34043"

# Kanso Ink

color-link default "#c5c9c7,#14171d"
color-link comment "#5c6066"
color-link identifier "#8ba4b0"
color-link identifier.class "#c5c9c7"
color-link identifier.var "#c5c9c7"
color-link constant "#c5c9c7"
color-link constant.number "#c4b28a"
color-link constant.string "#8a9a7b"
color-link constant.specialChar "#c5c9c7"
color-link constant.string.url "#c5c9c7"
color-link statement "#a292a3"
color-link symbol.operator "#a292a3"
color-link symbol.brackets "#c5c9c7"
color-link symbol.tag "#c4b28a"
color-link preproc "#938aa9"
color-link type "#7aa89f"
color-link type.keyword "#7aa89f"
color-link special "#c4b28a"
color-link underlined "#c5c9c7,underline"
color-link error "bold #c5c9c7"
color-link todo "bold #c4b28a"
color-link selection "#c5c9c7,#3e424a"
color-link hlsearch "#14171d,#8ea4a2"
color-link statusline "#14171d,#878b8c"
color-link statusline.inactive "#5c6066,#1f2227"
color-link tabbar "#878b8c,#1f2227"
color-link tabbar.inactive "#5c6066,#1f2227"
color-link gutter-error "#c4746e"
color-link gutter-warning "#c4b28a"
color-link line-number "#5c6066,#1f2227"
color-link current-line-number "#c5c9c7,#1f2227"
color-link diff-added "#8a9a7b"
color-link diff-modified "#c4b28a"
color-link diff-deleted "#c4746e"
color-link cursor-line "#1f2227"
color-link color-column "#1f2227"
color-link indent-char "#3b3e42"
color-link scrollbar "#5c6066"

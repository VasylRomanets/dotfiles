# Kanso Ink

color-link default "#c5c9c7,#14171d"
color-link comment "#5C6066"
color-link identifier "#8ba4b0"
color-link constant "#c4b28a"
color-link constant.number "#c4b28a"
color-link constant.string "#8a9a7b"
color-link constant.string.url "#8ba4b0"
color-link statement "#a292a3"
color-link symbol.operator "#878b8c"
color-link preproc "#938aa9"
color-link type "#7aa89f"
color-link special "#c4b28a"
color-link underlined "#8ba4b0,underline"
color-link error "bold #c4746e"
color-link todo "bold #c4b28a"
color-link selection "#c5c9c7,#3E424A"
color-link statusline "#14171d,#878b8c"
color-link statusline.inactive "#5C6066,#1d2026"
color-link tabbar "#878b8c,#1d2026"
color-link tabbar.inactive "#5C6066,#1d2026"
color-link gutter-error "#c4746e"
color-link gutter-warning "#c4b28a"
color-link line-number "#5C6066,#1d2026"
color-link current-line-number "#c5c9c7,#1d2026"
color-link diff-added "#8a9a7b"
color-link diff-modified "#c4b28a"
color-link diff-deleted "#c4746e"

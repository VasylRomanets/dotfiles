# Kanso Pearl

color-link default "#22262d,#f2f1ef"
color-link comment "#5c6066"
color-link identifier "#4d699b"
color-link identifier.class "#22262d"
color-link identifier.var "#22262d"
color-link constant "#22262d"
color-link constant.number "#77713f"
color-link constant.string "#6f894e"
color-link constant.specialChar "#22262d"
color-link constant.string.url "#22262d"
color-link statement "#b35b79"
color-link symbol.operator "#b35b79"
color-link symbol.brackets "#22262d"
color-link symbol.tag "#77713f"
color-link preproc "#624c83"
color-link type "#5e857a"
color-link type.keyword "#5e857a"
color-link special "#77713f"
color-link underlined "#22262d,underline"
color-link error "bold #22262d"
color-link todo "bold #77713f"
color-link selection "#22262d,#e2e1df"
color-link hlsearch "#f2f1ef,#597b75"
color-link statusline "#f2f1ef,#6b6d71"
color-link statusline.inactive "#5c6066,#e6e5e3"
color-link tabbar "#6b6d71,#e6e5e3"
color-link tabbar.inactive "#5c6066,#e6e5e3"
color-link gutter-error "#c84053"
color-link gutter-warning "#77713f"
color-link line-number "#5c6066,#e6e5e3"
color-link current-line-number "#22262d,#e6e5e3"
color-link diff-added "#6f894e"
color-link diff-modified "#77713f"
color-link diff-deleted "#c84053"
color-link cursor-line "#e6e5e3"
color-link color-column "#e6e5e3"
color-link indent-char "#c4c4c4"
color-link scrollbar "#5c6066"

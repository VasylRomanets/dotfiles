# Matte Black

color-link default "#bebebe,#121212"
color-link comment "#8a8a8d"
color-link identifier "#dc2626"
color-link identifier.class "#fbbf24"
color-link identifier.var "#eaeaea"
color-link constant "#10b981"
color-link constant.number "#efbf04"
color-link constant.string "#eaeaea"
color-link constant.specialChar "#efbf04"
color-link constant.string.url "#f59e0b"
color-link statement "#059669"
color-link symbol.operator "#bebebe"
color-link symbol.brackets "#8a8a8d"
color-link symbol.tag "#059669"
color-link preproc "#fbbf24"
color-link type "#fbbf24"
color-link type.keyword "#fbbf24"
color-link special "#059669"
color-link underlined "#f59e0b,underline"
color-link error "bold #b91c1c"
color-link todo "bold #b91c1c"
color-link selection "#bebebe,#333333"
color-link hlsearch "#121212,#f59e0b"
color-link statusline "#121212,#828282"
color-link statusline.inactive "#8a8a8d,#1c1c1c"
color-link tabbar "#828282,#1c1c1c"
color-link tabbar.inactive "#8a8a8d,#1c1c1c"
color-link gutter-error "#d35f5f"
color-link gutter-warning "#b91c1c"
color-link line-number "#8a8a8d,#1c1c1c"
color-link current-line-number "#bebebe,#1c1c1c"
color-link diff-added "#ffc107"
color-link diff-modified "#b91c1c"
color-link diff-deleted "#d35f5f"
color-link cursor-line "#212121"
color-link color-column "#212121"
color-link indent-char "#383838"
color-link scrollbar "#8a8a8d"

# Mellow Light

color-link default "#4d4b65,#f7f7f7"
color-link comment "#8e8e91"
color-link identifier "#5a5a5e"
color-link identifier.class "#215fac"
color-link identifier.var "#4d4b65"
color-link constant "#c65c00"
color-link constant.number "#bf386e"
color-link constant.string "#598c15"
color-link constant.specialChar "#bf386e"
color-link constant.string.url "#d82b65"
color-link statement "#174c97"
color-link symbol.operator "#c65c00"
color-link symbol.brackets "#8c8c8f"
color-link symbol.tag "#d82b65"
color-link preproc "#4d4b65"
color-link type "#c65c00"
color-link type.keyword "#c65c00"
color-link special "#d82b65"
color-link underlined "#d82b65,underline"
color-link error "bold #e05439"
color-link todo "bold #c65c00"
color-link selection "#4d4b65,#d3d3d4"
color-link hlsearch "#f7f7f7,#174c97"
color-link statusline "#f7f7f7,#888798"
color-link statusline.inactive "#8e8e91,#ededee"
color-link tabbar "#888798,#ededee"
color-link tabbar.inactive "#8e8e91,#ededee"
color-link gutter-error "#e05439"
color-link gutter-warning "#c65c00"
color-link line-number "#8e8e91,#ededee"
color-link current-line-number "#4d4b65,#ededee"
color-link diff-added "#598c15"
color-link diff-modified "#c65c00"
color-link diff-deleted "#e05439"
color-link cursor-line "#ededee"
color-link color-column "#ededee"
color-link indent-char "#d2d1d7"
color-link scrollbar "#8e8e91"

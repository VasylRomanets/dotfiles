# Mellow

color-link default "#c9c7cd,#161617"
color-link comment "#757581"
color-link identifier "#c1c0d4"
color-link identifier.class "#b9aeda"
color-link identifier.var "#c9c7cd"
color-link constant "#e6b99d"
color-link constant.number "#e29eca"
color-link constant.string "#90b99f"
color-link constant.specialChar "#e29eca"
color-link constant.string.url "#ea83a5"
color-link statement "#aca1cf"
color-link symbol.operator "#e6b99d"
color-link symbol.brackets "#9998a8"
color-link symbol.tag "#ea83a5"
color-link preproc "#c9c7cd"
color-link type "#e6b99d"
color-link type.keyword "#e6b99d"
color-link special "#ea83a5"
color-link underlined "#ea83a5,underline"
color-link error "bold #f5a191"
color-link todo "bold #e6b99d"
color-link selection "#c9c7cd,#2a2a2d"
color-link hlsearch "#161617,#aca1cf"
color-link statusline "#161617,#8a898d"
color-link statusline.inactive "#757581,#212122"
color-link tabbar "#8a898d,#212122"
color-link tabbar.inactive "#757581,#212122"
color-link gutter-error "#f5a191"
color-link gutter-warning "#e6b99d"
color-link line-number "#757581,#212122"
color-link current-line-number "#c9c7cd,#212122"
color-link diff-added "#90b99f"
color-link diff-modified "#e6b99d"
color-link diff-deleted "#f5a191"
color-link cursor-line "#212122"
color-link color-column "#212122"
color-link indent-char "#3d3d3f"
color-link scrollbar "#757581"

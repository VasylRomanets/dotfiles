# Miasma

color-link default "#c2c2b0,#222222"
color-link comment "#666666"
color-link identifier "#78824b"
color-link identifier.class "#78824b"
color-link identifier.var "#d7c483"
color-link constant "#bb7744"
color-link constant.number "#78824b"
color-link constant.string "#685742"
color-link constant.specialChar "#b36d43"
color-link constant.string.url "#c2c2b0"
color-link statement "#5f875f"
color-link symbol.operator "#5f875f"
color-link symbol.brackets "#c2c2b0"
color-link symbol.tag "#5f875f"
color-link preproc "#c2c2b0"
color-link type "#78824b"
color-link type.keyword "#78824b"
color-link special "#5f875f"
color-link underlined "#c2c2b0,underline"
color-link error "bold #b36d43"
color-link todo "bold #b36d43"
color-link selection "#c2c2b0,#78824b"
color-link hlsearch "#222222,#78824b"
color-link statusline "#222222,#8a8a7e"
color-link statusline.inactive "#666666,#2c2c2b"
color-link tabbar "#8a8a7e,#2c2c2b"
color-link tabbar.inactive "#666666,#2c2c2b"
color-link gutter-error "#685742"
color-link gutter-warning "#b36d43"
color-link line-number "#666666,#2c2c2b"
color-link current-line-number "#c2c2b0,#2c2c2b"
color-link diff-added "#5f875f"
color-link diff-modified "#b36d43"
color-link diff-deleted "#685742"
color-link cursor-line "#1c1c1c"
color-link color-column "#1c1c1c"
color-link indent-char "#454541"
color-link scrollbar "#666666"

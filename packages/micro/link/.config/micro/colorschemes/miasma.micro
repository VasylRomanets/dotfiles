# Miasma
# https://github.com/xero/miasma.nvim

color-link default "#C2C2B0,#222222"
color-link comment "#666666"
color-link identifier "#D7C483"
color-link constant "#BB7744"
color-link constant.number "#78824B"
color-link constant.string "#685742"
color-link constant.string.url "#C9A554"
color-link statement "#5F875F"
color-link symbol.operator "#D7C483"
color-link preproc "#C9A554"
color-link type "#78824B"
color-link special "#BB7744"
color-link underlined "#78824B,underline"
color-link error "bold #B36D43"
color-link todo "bold #D7C483"
color-link selection "#222222,#E4C47A"
color-link statusline "#222222,#5F875F"
color-link statusline.inactive "#666666,#1C1C1C"
color-link tabbar "#222222,#1C1C1C"
color-link tabbar.inactive "#666666,#1C1C1C"
color-link gutter-error "#B36D43"
color-link gutter-warning "#685742"
color-link line-number "#666666,#1C1C1C"
color-link current-line-number "#C2C2B0,#1C1C1C"
color-link diff-added "#5F875F"
color-link diff-modified "#685742"
color-link diff-deleted "#B36D43"

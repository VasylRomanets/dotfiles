# Neon Blade Runner

color-link default "#b8c4d0,#121212"
color-link comment "#758494"
color-link identifier "#4eb8a8"
color-link identifier.class "#5cc8d0"
color-link identifier.var "#b8c4d0"
color-link constant "#d65f7e"
color-link constant.number "#d65f7e"
color-link constant.string "#d4a040"
color-link constant.specialChar "#5cc8d0"
color-link constant.string.url "#5cc8d0"
color-link statement "#e8609a"
color-link symbol.operator "#758494"
color-link symbol.brackets "#758494"
color-link symbol.tag "#e8609a"
color-link preproc "#b8c4d0"
color-link type "#e8609a"
color-link type.keyword "#e8609a"
color-link special "#e8609a"
color-link underlined "#5cc8d0,underline"
color-link error "bold #d65f7e"
color-link todo "bold #d4a040"
color-link selection "#b8c4d0,#412330"
color-link hlsearch "#121212,#e8609a"
color-link statusline "#121212,#7e868e"
color-link statusline.inactive "#758494,#1c1d1d"
color-link tabbar "#7e868e,#1c1d1d"
color-link tabbar.inactive "#758494,#1c1d1d"
color-link gutter-error "#d65f7e"
color-link gutter-warning "#d4a040"
color-link line-number "#758494,#1c1d1d"
color-link current-line-number "#b8c4d0,#1c1d1d"
color-link diff-added "#4eb8a8"
color-link diff-modified "#d4a040"
color-link diff-deleted "#d65f7e"
color-link cursor-line "#1c1d1d"
color-link color-column "#1c1d1d"
color-link indent-char "#37393c"
color-link scrollbar "#758494"

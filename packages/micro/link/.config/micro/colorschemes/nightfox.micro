# Nightfox

color-link default "#cdcecf,#192330"
color-link comment "#39506d"
color-link identifier "#6085b6"
color-link identifier.class "#dbc074"
color-link identifier.var "#d6d6d7"
color-link constant "#c94f6d"
color-link constant.number "#dbc074"
color-link constant.string "#81b29a"
color-link constant.specialChar "#aeafb0"
color-link constant.string.url "#b7bdf8"
color-link statement "#9d79d6"
color-link symbol.operator "#63cdcf"
color-link symbol.brackets "#d6d6d7"
color-link symbol.tag "#6085b6"
color-link preproc "#d6d6d7"
color-link type "#9d79d6"
color-link type.keyword "#9d79d6"
color-link special "#6085b6"
color-link underlined "#b7bdf8,underline"
color-link error "bold #d6d6d7"
color-link todo "bold #dbc074"
color-link selection "#cdcecf,#d6d6d7"
color-link hlsearch "#192330,#63cdcf"
color-link statusline "#192330,#8e9297"
color-link statusline.inactive "#39506d,#242d3a"
color-link tabbar "#8e9297,#242d3a"
color-link tabbar.inactive "#39506d,#242d3a"
color-link gutter-error "#c94f6d"
color-link gutter-warning "#dbc074"
color-link line-number "#39506d,#242d3a"
color-link current-line-number "#cdcecf,#242d3a"
color-link diff-added "#81b29a"
color-link diff-modified "#dbc074"
color-link diff-deleted "#c94f6d"
color-link cursor-line "#212e3f"
color-link color-column "#212e3f"
color-link indent-char "#414953"
color-link scrollbar "#39506d"

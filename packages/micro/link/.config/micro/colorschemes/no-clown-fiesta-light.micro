# No Clown Fiesta Light

color-link default "#151515,#e1e1e1"
color-link comment "#2b2b2b"
color-link identifier "#8ba1bf"
color-link identifier.class "#151515"
color-link identifier.var "#151515"
color-link constant "#151515"
color-link constant.number "#b89058"
color-link constant.string "#677940"
color-link constant.specialChar "#151515"
color-link constant.string.url "#151515"
color-link statement "#aa759f"
color-link symbol.operator "#aa759f"
color-link symbol.brackets "#151515"
color-link symbol.tag "#b89058"
color-link preproc "#aa759f"
color-link type "#99ab93"
color-link type.keyword "#99ab93"
color-link special "#b89058"
color-link underlined "#151515,underline"
color-link error "bold #151515"
color-link todo "bold #b89058"
color-link selection "#151515,#c6d5de"
color-link hlsearch "#e1e1e1,#3e5f66"
color-link statusline "#e1e1e1,#5c5c5c"
color-link statusline.inactive "#2b2b2b,#d5d5d5"
color-link tabbar "#5c5c5c,#d5d5d5"
color-link tabbar.inactive "#2b2b2b,#d5d5d5"
color-link gutter-error "#874e42"
color-link gutter-warning "#b89058"
color-link line-number "#2b2b2b,#d5d5d5"
color-link current-line-number "#151515,#d5d5d5"
color-link diff-added "#677940"
color-link diff-modified "#b89058"
color-link diff-deleted "#874e42"
color-link cursor-line "#d5d5d5"
color-link color-column "#d5d5d5"
color-link indent-char "#b4b4b4"
color-link scrollbar "#2b2b2b"

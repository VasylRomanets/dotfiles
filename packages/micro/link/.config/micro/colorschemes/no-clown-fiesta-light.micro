# No Clown Fiesta Light

color-link default "#151515,#e1e1e1"
color-link comment "#2b2b2b"
color-link identifier "#8ba1bf"
color-link constant "#b89058"
color-link constant.number "#b89058"
color-link constant.string "#677940"
color-link constant.string.url "#8ba1bf"
color-link statement "#aa759f"
color-link symbol.operator "#5c5c5c"
color-link preproc "#aa759f"
color-link type "#99ab93"
color-link special "#b89058"
color-link underlined "#8ba1bf,underline"
color-link error "bold #874e42"
color-link todo "bold #b89058"
color-link selection "#151515,#c6d5de"
color-link statusline "#e1e1e1,#5c5c5c"
color-link statusline.inactive "#2b2b2b,#d7d7d7"
color-link tabbar "#5c5c5c,#d7d7d7"
color-link tabbar.inactive "#2b2b2b,#d7d7d7"
color-link gutter-error "#874e42"
color-link gutter-warning "#b89058"
color-link line-number "#2b2b2b,#d7d7d7"
color-link current-line-number "#151515,#d7d7d7"
color-link diff-added "#677940"
color-link diff-modified "#b89058"
color-link diff-deleted "#874e42"

color-link constant.number "#f4bf75"
color-link constant.string "#90a959"
color-link constant.string.url "#bad7ff"
color-link statement "#aa759f"
color-link symbol.operator "#97989a"
color-link preproc "#aa759f"
color-link type "#88afa2"

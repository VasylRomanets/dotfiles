# No Clown Fiesta

color-link default "#e0e1e4,#101010"
color-link comment "#727272"
color-link identifier "#bad7ff"
color-link identifier.class "#e0e1e4"
color-link identifier.var "#e0e1e4"
color-link constant "#e0e1e4"
color-link constant.number "#f4bf75"
color-link constant.string "#90a959"
color-link constant.specialChar "#e0e1e4"
color-link constant.string.url "#e0e1e4"
color-link statement "#aa759f"
color-link symbol.operator "#aa759f"
color-link symbol.brackets "#e0e1e4"
color-link symbol.tag "#f4bf75"
color-link preproc "#aa759f"
color-link type "#88afa2"
color-link type.keyword "#88afa2"
color-link special "#f4bf75"
color-link underlined "#e0e1e4,underline"
color-link error "bold #e0e1e4"
color-link todo "bold #f4bf75"
color-link selection "#e0e1e4,#696d79"
color-link hlsearch "#101010,#88afa2"
color-link statusline "#101010,#97989a"
color-link statusline.inactive "#727272,#1c1d1d"
color-link tabbar "#97989a,#1c1d1d"
color-link tabbar.inactive "#727272,#1c1d1d"
color-link gutter-error "#b46958"
color-link gutter-warning "#f4bf75"
color-link line-number "#727272,#1c1d1d"
color-link current-line-number "#e0e1e4,#1c1d1d"
color-link diff-added "#90a959"
color-link diff-modified "#f4bf75"
color-link diff-deleted "#b46958"
color-link cursor-line "#1c1d1d"
color-link color-column "#1c1d1d"
color-link indent-char "#3e3e3f"
color-link scrollbar "#727272"

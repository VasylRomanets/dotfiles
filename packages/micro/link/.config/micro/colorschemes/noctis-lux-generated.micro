# Noctis Lux

color-link default "#005661,#fef8ec"
color-link comment "#8ca6a6"
color-link identifier "#0095a8"
color-link identifier.class "#00bdd6"
color-link identifier.var "#fa8900"
color-link constant "#5842ff"
color-link constant.number "#5842ff"
color-link constant.string "#00b368"
color-link constant.specialChar "#0094f0"
color-link constant.string.url "#0095a8"
color-link statement "#ff5792"
color-link symbol.operator "#ff5792"
color-link symbol.brackets "#005661"
color-link symbol.tag "#e64100"
color-link preproc "#005661"
color-link type "#e64100"
color-link type.keyword "#e64100"
color-link special "#e64100"
color-link underlined "#0095a8,underline"
color-link error "bold #ff530f"
color-link todo "bold #f49725"
color-link selection "#005661,#f4e2b8"
color-link hlsearch "#fef8ec,#00bdd6"
color-link statusline "#fef8ec,#598f92"
color-link statusline.inactive "#8ca6a6,#efeee4"
color-link tabbar "#598f92,#efeee4"
color-link tabbar.inactive "#8ca6a6,#efeee4"
color-link gutter-error "#e34e1c"
color-link gutter-warning "#f49725"
color-link line-number "#8ca6a6,#efeee4"
color-link current-line-number "#005661,#efeee4"
color-link diff-added "#00b368"
color-link diff-modified "#f49725"
color-link diff-deleted "#e34e1c"
color-link cursor-line "#d1ebef"
color-link color-column "#d1ebef"
color-link indent-char "#c6d4cd"
color-link scrollbar "#8ca6a6"

# Noctis Minimus

color-link default "#c5cdd3,#1b2932"
color-link comment "#5e7887"
color-link identifier "#3f848d"
color-link constant "#a88c00"
color-link constant.number "#7068b1"
color-link constant.string "#72c09f"
color-link constant.string.url "#6196b8"
color-link statement "#c88da2"
color-link symbol.operator "#8a949b"
color-link preproc "#be856f"
color-link type "#72b7c0"
color-link special "#c37455"
color-link underlined "#6196b8,underline"
color-link error "bold #c08872"
color-link todo "bold #c8a984"
color-link selection "#c5cdd3,#263c4a"
color-link statusline "#1b2932,#8a949b"
color-link statusline.inactive "#5e7887,#24313a"
color-link tabbar "#8a949b,#24313a"
color-link tabbar.inactive "#5e7887,#24313a"
color-link gutter-error "#c08872"
color-link gutter-warning "#c8a984"
color-link line-number "#5e7887,#24313a"
color-link current-line-number "#c5cdd3,#24313a"
color-link diff-added "#72c09f"
color-link diff-modified "#c8a984"
color-link diff-deleted "#c08872"

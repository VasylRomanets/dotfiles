# Noctis Uva

color-link default "#c5c2d6,#292640"
color-link comment "#716c93"
color-link identifier "#16a3b6"
color-link identifier.class "#49d6e9"
color-link identifier.var "#e4b781"
color-link constant "#7060eb"
color-link constant.number "#7060eb"
color-link constant.string "#49e9a6"
color-link constant.specialChar "#49ace9"
color-link constant.string.url "#16a3b6"
color-link statement "#df769b"
color-link symbol.operator "#df769b"
color-link symbol.brackets "#c5c2d6"
color-link symbol.tag "#e66533"
color-link preproc "#c5c2d6"
color-link type "#e66533"
color-link type.keyword "#e66533"
color-link special "#e66533"
color-link underlined "#16a3b6,underline"
color-link error "bold #e3541c"
color-link todo "bold #e4b781"
color-link selection "#c5c2d6,#35325a"
color-link hlsearch "#292640,#49d6e9"
color-link statusline "#292640,#8e8ba2"
color-link statusline.inactive "#716c93,#322f49"
color-link tabbar "#8e8ba2,#322f49"
color-link tabbar.inactive "#716c93,#322f49"
color-link gutter-error "#e66533"
color-link gutter-warning "#e4b781"
color-link line-number "#716c93,#322f49"
color-link current-line-number "#c5c2d6,#322f49"
color-link diff-added "#49e9a6"
color-link diff-modified "#e4b781"
color-link diff-deleted "#e66533"
color-link cursor-line "#35305a"
color-link color-column "#35305a"
color-link indent-char "#4b4861"
color-link scrollbar "#716c93"

# Noctis

color-link default "#b2cacd,#052529"
color-link comment "#5b858b"
color-link identifier "#16a3b6"
color-link constant "#d5971a"
color-link constant.number "#7060eb"
color-link constant.string "#49e9a6"
color-link constant.string.url "#49ace9"
color-link statement "#df769b"
color-link symbol.operator "#759094"
color-link preproc "#d67e5c"
color-link type "#49d6e9"
color-link special "#e66533"
color-link underlined "#49ace9,underline"
color-link error "bold #e66533"
color-link todo "bold #e4b781"
color-link selection "#b2cacd,#0f3a3f"
color-link statusline "#052529,#759094"
color-link statusline.inactive "#5b858b,#0e2d31"
color-link tabbar "#759094,#0e2d31"
color-link tabbar.inactive "#5b858b,#0e2d31"
color-link gutter-error "#e66533"
color-link gutter-warning "#e4b781"
color-link line-number "#5b858b,#0e2d31"
color-link current-line-number "#b2cacd,#0e2d31"
color-link diff-added "#49e9a6"
color-link diff-modified "#e4b781"
color-link diff-deleted "#e66533"

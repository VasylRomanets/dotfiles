# Nord Wave

color-link default "#d8dee9,#212121"
color-link comment "#6a6d71"
color-link identifier "#88c0d0"
color-link constant "#ebcb8b"
color-link constant.number "#ebcb8b"
color-link constant.string "#a3be8c"
color-link constant.string.url "#81a1c1"
color-link statement "#b48ead"
color-link symbol.operator "#989ca3"
color-link preproc "#b48ead"
color-link type "#8fbcbb"
color-link special "#ebcb8b"
color-link underlined "#81a1c1,underline"
color-link error "bold #bf616a"
color-link todo "bold #ebcb8b"
color-link selection "#d8dee9,#373839"
color-link statusline "#212121,#989ca3"
color-link statusline.inactive "#6a6d71,#2a2a2b"
color-link tabbar "#989ca3,#2a2a2b"
color-link tabbar.inactive "#6a6d71,#2a2a2b"
color-link gutter-error "#bf616a"
color-link gutter-warning "#ebcb8b"
color-link line-number "#6a6d71,#2a2a2b"
color-link current-line-number "#d8dee9,#2a2a2b"
color-link diff-added "#a3be8c"
color-link diff-modified "#ebcb8b"
color-link diff-deleted "#bf616a"

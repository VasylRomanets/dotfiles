# Nord

color-link default "#d8dee9,#2e3440"
color-link comment "#616e88"
color-link identifier "#88c0d0"
color-link identifier.class "#8fbcbb"
color-link identifier.var "#d8dee9"
color-link constant "#81a1c1"
color-link constant.number "#b48ead"
color-link constant.string "#d8dee9"
color-link constant.specialChar "#ebcb8b"
color-link constant.string.url "#d8dee9"
color-link statement "#d8dee9"
color-link symbol.operator "#81a1c1"
color-link symbol.brackets "#d8dee9"
color-link symbol.tag "#81a1c1"
color-link preproc "#d8dee9"
color-link type "#81a1c1"
color-link type.keyword "#81a1c1"
color-link special "#81a1c1"
color-link underlined "#d8dee9,underline"
color-link error "bold #d8dee9"
color-link todo "bold #ebcb8b"
color-link selection "#d8dee9,#3f4758"
color-link hlsearch "#2e3440,#81a1c1"
color-link statusline "#2e3440,#9ca2ae"
color-link statusline.inactive "#616e88,#383e4a"
color-link tabbar "#9ca2ae,#383e4a"
color-link tabbar.inactive "#616e88,#383e4a"
color-link gutter-error "#bf616a"
color-link gutter-warning "#ebcb8b"
color-link line-number "#616e88,#383e4a"
color-link current-line-number "#d8dee9,#383e4a"
color-link diff-added "#a3be8c"
color-link diff-modified "#ebcb8b"
color-link diff-deleted "#bf616a"
color-link cursor-line "#353c4a"
color-link color-column "#353c4a"
color-link indent-char "#535965"
color-link scrollbar "#616e88"

# Nord
# https://www.nordtheme.com/

color-link default "#d8dee9,#2e3440"
color-link comment "#4c566a"
color-link identifier "#d8dee9"
color-link constant "#ebcb8b"
color-link constant.number "#ebcb8b"
color-link constant.string "#a3be8c"
color-link constant.string.url "#88c0d0"
color-link statement "#81a1c1"
color-link symbol.operator "#88c0d0"
color-link preproc "#b48ead"
color-link type "#ebcb8b"
color-link special "#d08770"
color-link underlined "#88c0d0,underline"
color-link error "bold #bf616a"
color-link todo "bold #ebcb8b"
color-link selection "#e5e9f0,#4c566a"
color-link statusline "#2e3440,#a3be8c"
color-link statusline.inactive "#4c566a,#3b4252"
color-link tabbar "#2e3440,#3b4252"
color-link tabbar.inactive "#4c566a,#3b4252"
color-link gutter-error "#bf616a"
color-link gutter-warning "#ebcb8b"
color-link line-number "#4c566a,#3b4252"
color-link current-line-number "#d8dee9,#3b4252"
color-link diff-added "#a3be8c"
color-link diff-modified "#ebcb8b"
color-link diff-deleted "#bf616a"

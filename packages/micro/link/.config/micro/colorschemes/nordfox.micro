# Nordfox

color-link default "#cdcecf,#2e3440"
color-link comment "#5a657d"
color-link identifier "#668aab"
color-link identifier.class "#ebcb8b"
color-link identifier.var "#c7cdd9"
color-link constant "#bf616a"
color-link constant.number "#ebcb8b"
color-link constant.string "#a3be8c"
color-link constant.specialChar "#abb1bb"
color-link constant.string.url "#b7bdf8"
color-link statement "#b48ead"
color-link symbol.operator "#88c0d0"
color-link symbol.brackets "#c7cdd9"
color-link symbol.tag "#668aab"
color-link preproc "#c7cdd9"
color-link type "#b48ead"
color-link type.keyword "#b48ead"
color-link special "#668aab"
color-link underlined "#b7bdf8,underline"
color-link error "bold #c7cdd9"
color-link todo "bold #ebcb8b"
color-link selection "#cdcecf,#c7cdd9"
color-link hlsearch "#2e3440,#88c0d0"
color-link statusline "#2e3440,#95989d"
color-link statusline.inactive "#5a657d,#383d49"
color-link tabbar "#95989d,#383d49"
color-link tabbar.inactive "#5a657d,#383d49"
color-link gutter-error "#bf616a"
color-link gutter-warning "#ebcb8b"
color-link line-number "#5a657d,#383d49"
color-link current-line-number "#cdcecf,#383d49"
color-link diff-added "#a3be8c"
color-link diff-modified "#ebcb8b"
color-link diff-deleted "#bf616a"
color-link cursor-line "#39404f"
color-link color-column "#39404f"
color-link indent-char "#51565f"
color-link scrollbar "#5a657d"

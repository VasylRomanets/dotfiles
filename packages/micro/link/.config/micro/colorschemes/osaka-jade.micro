# Osaka Jade

color-link default "#c1c497,#111c18"
color-link comment "#53685b"
color-link identifier "#2dd5b7"
color-link identifier.class "#8cd3cb"
color-link identifier.var "#c1c497"
color-link constant "#e5c736"
color-link constant.number "#e5c736"
color-link constant.string "#63b07a"
color-link constant.specialChar "#e5c736"
color-link constant.string.url "#8cd3cb"
color-link statement "#d2689c"
color-link symbol.operator "#d6d5bc"
color-link symbol.brackets "#c1c497"
color-link symbol.tag "#ff5345"
color-link preproc "#d2689c"
color-link type "#8cd3cb"
color-link type.keyword "#8cd3cb"
color-link special "#ff5345"
color-link underlined "#8cd3cb,underline"
color-link error "bold #ff5345"
color-link todo "bold #459451"
color-link selection "#c1c497,#32473b"
color-link hlsearch "#111c18,#509475"
color-link statusline "#111c18,#83896b"
color-link statusline.inactive "#53685b,#1c2620"
color-link tabbar "#83896b,#1c2620"
color-link tabbar.inactive "#53685b,#1c2620"
color-link gutter-error "#ff5345"
color-link gutter-warning "#459451"
color-link line-number "#53685b,#1c2620"
color-link current-line-number "#c1c497,#1c2620"
color-link diff-added "#549e6a"
color-link diff-modified "#459451"
color-link diff-deleted "#ff5345"
color-link cursor-line "#23372b"
color-link color-column "#23372b"
color-link indent-char "#384134"
color-link scrollbar "#53685b"

# Oxford

color-link default "#d6d1c9,#292b31"
color-link comment "#b4ab99"
color-link identifier "#bda07f"
color-link identifier.class "#f3e9bd"
color-link identifier.var "#dd5544"
color-link constant "#f28b7c"
color-link constant.number "#f28b7c"
color-link constant.string "#76856a"
color-link constant.specialChar "#9b907f"
color-link constant.string.url "#d6d1c9"
color-link statement "#b7a593"
color-link symbol.operator "#b7a593"
color-link symbol.brackets "#ffffff"
color-link symbol.tag "#dd5544"
color-link preproc "#d6d1c9"
color-link type "#f3e9bd"
color-link type.keyword "#f3e9bd"
color-link special "#dd5544"
color-link underlined "#d6d1c9,underline"
color-link error "bold #dd5544"
color-link todo "bold #f3e9bd"
color-link selection "#d6d1c9,#554e48"
color-link hlsearch "#292b31,#bda07f"
color-link statusline "#292b31,#999794"
color-link statusline.inactive "#b4ab99,#33353a"
color-link tabbar "#999794,#33353a"
color-link tabbar.inactive "#b4ab99,#33353a"
color-link gutter-error "#dd5544"
color-link gutter-warning "#f3e9bd"
color-link line-number "#b4ab99,#33353a"
color-link current-line-number "#d6d1c9,#33353a"
color-link diff-added "#76856a"
color-link diff-modified "#f3e9bd"
color-link diff-deleted "#dd5544"
color-link cursor-line "#33353a"
color-link color-column "#33353a"
color-link indent-char "#4f5052"
color-link scrollbar "#b4ab99"

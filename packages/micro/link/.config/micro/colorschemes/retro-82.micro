# Retro 82

color-link default "#f6dcac,#00172e"
color-link comment "#134e5a"
color-link identifier "#f85525"
color-link identifier.class "#e97b3c"
color-link identifier.var "#f85525"
color-link constant "#f6dcac"
color-link constant.number "#f6dcac"
color-link constant.string "#3f8f8a"
color-link constant.specialChar "#8cbfb8"
color-link constant.string.url "#a7c9c6"
color-link statement "#3f8f8a"
color-link symbol.operator "#a7c9c6"
color-link symbol.brackets "#a7c9c6"
color-link symbol.tag "#f85525"
color-link preproc "#a7c9c6"
color-link type "#e97b3c"
color-link type.keyword "#e97b3c"
color-link special "#f85525"
color-link underlined "#a7c9c6,underline"
color-link error "bold #f85525"
color-link todo "bold #e97b3c"
color-link selection "#f6dcac,#0a3a45"
color-link hlsearch "#00172e,#faa968"
color-link statusline "#00172e,#a09780"
color-link statusline.inactive "#134e5a,#0f2336"
color-link tabbar "#a09780,#0f2336"
color-link tabbar.inactive "#134e5a,#0f2336"
color-link gutter-error "#f85525"
color-link gutter-warning "#e97b3c"
color-link line-number "#134e5a,#0f2336"
color-link current-line-number "#f6dcac,#0f2336"
color-link diff-added "#028391"
color-link diff-modified "#e97b3c"
color-link diff-deleted "#f85525"
color-link cursor-line "#01204e"
color-link color-column "#01204e"
color-link indent-char "#36424a"
color-link scrollbar "#134e5a"

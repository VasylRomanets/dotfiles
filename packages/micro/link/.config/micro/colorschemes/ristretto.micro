# Ristretto

color-link default "#e6d9db,#2c2525"
color-link comment "#72696a"
color-link identifier "#adda78"
color-link identifier.class "#85dacc"
color-link identifier.var "#e6d9db"
color-link constant "#a8a9eb"
color-link constant.number "#a8a9eb"
color-link constant.string "#f9cc6c"
color-link constant.specialChar "#a8a9eb"
color-link constant.string.url "#85dacc"
color-link statement "#fd6883"
color-link symbol.operator "#fd6883"
color-link symbol.brackets "#e6d9db"
color-link symbol.tag "#fd6883"
color-link preproc "#fd6883"
color-link type "#85dacc"
color-link type.keyword "#85dacc"
color-link special "#fd6883"
color-link underlined "#85dacc,underline"
color-link error "bold #ff8297"
color-link todo "bold #f9cc6c"
color-link selection "#e6d9db,#403e41"
color-link hlsearch "#2c2525,#f38d70"
color-link statusline "#2c2525,#9a9091"
color-link statusline.inactive "#72696a,#373030"
color-link tabbar "#9a9091,#373030"
color-link tabbar.inactive "#72696a,#373030"
color-link gutter-error "#fd6883"
color-link gutter-warning "#f9cc6c"
color-link line-number "#72696a,#373030"
color-link current-line-number "#e6d9db,#373030"
color-link diff-added "#adda78"
color-link diff-modified "#f9cc6c"
color-link diff-deleted "#fd6883"
color-link cursor-line "#3d2f2a"
color-link color-column "#3d2f2a"
color-link indent-char "#554d4d"
color-link scrollbar "#72696a"

# Rose Pine

color-link default "#e0def4,#191724"
color-link comment "#6e6a86"
color-link identifier "#ebbcba"
color-link identifier.class "#9ccfd8"
color-link identifier.var "#e0def4"
color-link constant "#9ccfd8"
color-link constant.number "#9ccfd8"
color-link constant.string "#f6c177"
color-link constant.specialChar "#ebbcba"
color-link constant.string.url "#e0def4"
color-link statement "#31748f"
color-link symbol.operator "#908caa"
color-link symbol.brackets "#e0def4"
color-link symbol.tag "#c4a7e7"
color-link preproc "#e0def4"
color-link type "#31748f"
color-link type.keyword "#31748f"
color-link special "#c4a7e7"
color-link underlined "#e0def4,underline"
color-link error "bold #eb6f92"
color-link todo "bold #f6c177"
color-link selection "#e0def4,#403d52"
color-link hlsearch "#191724,#31748f"
color-link statusline "#191724,#9a98ab"
color-link statusline.inactive "#6e6a86,#252330"
color-link tabbar "#9a98ab,#252330"
color-link tabbar.inactive "#6e6a86,#252330"
color-link gutter-error "#eb6f92"
color-link gutter-warning "#f6c177"
color-link line-number "#6e6a86,#252330"
color-link current-line-number "#e0def4,#252330"
color-link diff-added "#31748f"
color-link diff-modified "#f6c177"
color-link diff-deleted "#eb6f92"
color-link cursor-line "#1f1d2e"
color-link color-column "#1f1d2e"
color-link indent-char "#454352"
color-link scrollbar "#6e6a86"

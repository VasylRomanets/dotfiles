# Rouge 2

color-link default "#a2a3aa,#17182b"
color-link comment "#676775"
color-link identifier "#d7a1a5"
color-link identifier.class "#c6797e"
color-link identifier.var "#c6797e"
color-link constant "#f0b7a7"
color-link constant.number "#f0b7a7"
color-link constant.string "#969e92"
color-link constant.specialChar "#f0b7a7"
color-link constant.string.url "#74888c"
color-link statement "#8283a1"
color-link symbol.operator "#8283a1"
color-link symbol.brackets "#8283a1"
color-link symbol.tag "#c6797e"
color-link preproc "#a2a3aa"
color-link type "#8283a1"
color-link type.keyword "#8283a1"
color-link special "#c6797e"
color-link underlined "#74888c,underline"
color-link error "bold #db6375"
color-link todo "bold #dbcdab"
color-link selection "#a2a3aa,#2b3d47"
color-link hlsearch "#17182b,#c6797e"
color-link statusline "#17182b,#71727e"
color-link statusline.inactive "#676775,#1f2033"
color-link tabbar "#71727e,#1f2033"
color-link tabbar.inactive "#676775,#1f2033"
color-link gutter-error "#c6797e"
color-link gutter-warning "#dbcdab"
color-link line-number "#676775,#1f2033"
color-link current-line-number "#a2a3aa,#1f2033"
color-link diff-added "#969e92"
color-link diff-modified "#dbcdab"
color-link diff-deleted "#c6797e"
color-link cursor-line "#1f2033"
color-link color-column "#1f2033"
color-link indent-char "#363747"
color-link scrollbar "#676775"

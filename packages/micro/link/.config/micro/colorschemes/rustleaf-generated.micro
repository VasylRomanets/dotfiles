# Rustleaf

color-link default "#bcb7b0,#221f20"
color-link comment "#928374"
color-link identifier "#bdbd89"
color-link identifier.class "#d3b580"
color-link identifier.var "#bcb7b0"
color-link constant "#ae6fae"
color-link constant.number "#ae6fae"
color-link constant.string "#80b780"
color-link constant.specialChar "#7cb6b6"
color-link constant.string.url "#9393c3"
color-link statement "#b27575"
color-link symbol.operator "#bcb7b0"
color-link symbol.brackets "#bcb7b0"
color-link symbol.tag "#b27575"
color-link preproc "#b27575"
color-link type "#d3b580"
color-link type.keyword "#d3b580"
color-link special "#b27575"
color-link underlined "#9393c3,underline"
color-link error "bold #d5aeae"
color-link todo "bold #bdbd89"
color-link selection "#bcb7b0,#5f5448"
color-link hlsearch "#221f20,#9393c3"
color-link statusline "#221f20,#86827e"
color-link statusline.inactive "#928374,#2b2829"
color-link tabbar "#86827e,#2b2829"
color-link tabbar.inactive "#928374,#2b2829"
color-link gutter-error "#b27575"
color-link gutter-warning "#bdbd89"
color-link line-number "#928374,#2b2829"
color-link current-line-number "#bcb7b0,#2b2829"
color-link diff-added "#80b780"
color-link diff-modified "#bdbd89"
color-link diff-deleted "#b27575"
color-link cursor-line "#2c2829"
color-link color-column "#2c2829"
color-link indent-char "#444040"
color-link scrollbar "#928374"

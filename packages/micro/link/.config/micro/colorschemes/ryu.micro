# Ryu

color-link default "#d6d0c5,#050505"
color-link comment "#5e5e5e"
color-link identifier "#75897f"
color-link identifier.class "#51605b"
color-link identifier.var "#d6d0c5"
color-link constant "#e07969"
color-link constant.number "#e07969"
color-link constant.string "#8b9388"
color-link constant.specialChar "#717c7c"
color-link constant.string.url "#75897f"
color-link statement "#c2a46d"
color-link symbol.operator "#d6d0c5"
color-link symbol.brackets "#6e6a65"
color-link symbol.tag "#df6124"
color-link preproc "#d6d0c5"
color-link type "#51605b"
color-link type.keyword "#51605b"
color-link special "#df6124"
color-link underlined "#75897f,underline"
color-link error "bold #da614e"
color-link todo "bold #c2a46d"
color-link selection "#d6d0c5,#843954"
color-link hlsearch "#050505,#525e5a"
color-link statusline "#050505,#8d8982"
color-link statusline.inactive "#5e5e5e,#121111"
color-link tabbar "#8d8982,#121111"
color-link tabbar.inactive "#5e5e5e,#121111"
color-link gutter-error "#da614e"
color-link gutter-warning "#c2a46d"
color-link line-number "#5e5e5e,#121111"
color-link current-line-number "#d6d0c5,#121111"
color-link diff-added "#8b9388"
color-link diff-modified "#c2a46d"
color-link diff-deleted "#da614e"
color-link cursor-line "#141414"
color-link color-column "#141414"
color-link indent-char "#33322f"
color-link scrollbar "#5e5e5e"

# Sora

color-link default "#c8d0e0,#0e1018"
color-link comment "#586478"
color-link identifier "#80c8e0"
color-link identifier.class "#d0a888"
color-link identifier.var "#b4bcd0"
color-link constant "#d4b878"
color-link constant.number "#d4b878"
color-link constant.string "#90c8a0"
color-link constant.specialChar "#78b8b0"
color-link constant.string.url "#c8d0e0"
color-link statement "#b0a0d8"
color-link symbol.operator "#8898b8"
color-link symbol.brackets "#c8d0e0"
color-link symbol.tag "#78b8b0"
color-link preproc "#b0a0d8"
color-link type "#b0a0d8"
color-link type.keyword "#b0a0d8"
color-link special "#78b8b0"
color-link underlined "#c8d0e0,underline"
color-link error "bold #c46c78"
color-link todo "bold #d4b878"
color-link selection "#c8d0e0,#1e2430"
color-link hlsearch "#0e1018,#80c8e0"
color-link statusline "#0e1018,#878d9a"
color-link statusline.inactive "#586478,#191c24"
color-link tabbar "#878d9a,#191c24"
color-link tabbar.inactive "#586478,#191c24"
color-link gutter-error "#c46c78"
color-link gutter-warning "#d4b878"
color-link line-number "#586478,#191c24"
color-link current-line-number "#c8d0e0,#191c24"
color-link diff-added "#90c8a0"
color-link diff-modified "#d4b878"
color-link diff-deleted "#c46c78"
color-link cursor-line "#171a24"
color-link color-column "#171a24"
color-link indent-char "#373a44"
color-link scrollbar "#586478"

# Terafox

color-link default "#e6eaea,#152528"
color-link comment "#2d4f56"
color-link identifier "#4d7d90"
color-link identifier.class "#fda47f"
color-link identifier.var "#eaeeee"
color-link constant "#e85c51"
color-link constant.number "#fda47f"
color-link constant.string "#7aa4a1"
color-link constant.specialChar "#cbd9d8"
color-link constant.string.url "#b7bdf8"
color-link statement "#ad5c7c"
color-link symbol.operator "#a1cdd8"
color-link symbol.brackets "#eaeeee"
color-link symbol.tag "#4d7d90"
color-link preproc "#eaeeee"
color-link type "#ad5c7c"
color-link type.keyword "#ad5c7c"
color-link special "#4d7d90"
color-link underlined "#b7bdf8,underline"
color-link error "bold #eaeeee"
color-link todo "bold #fda47f"
color-link selection "#e6eaea,#eaeeee"
color-link hlsearch "#152528,#a1cdd8"
color-link statusline "#152528,#9da5a6"
color-link statusline.inactive "#2d4f56,#223134"
color-link tabbar "#9da5a6,#223134"
color-link tabbar.inactive "#2d4f56,#223134"
color-link gutter-error "#e85c51"
color-link gutter-warning "#fda47f"
color-link line-number "#2d4f56,#223134"
color-link current-line-number "#e6eaea,#223134"
color-link diff-added "#7aa4a1"
color-link diff-modified "#fda47f"
color-link diff-deleted "#e85c51"
color-link cursor-line "#1d3337"
color-link color-column "#1d3337"
color-link indent-char "#435053"
color-link scrollbar "#2d4f56"

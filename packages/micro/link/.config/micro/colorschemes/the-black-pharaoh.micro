# The Black Pharaoh

color-link default "#b7a98d,#232227"
color-link comment "#796f65"
color-link identifier "#8f9696"
color-link identifier.class "#b7a98d"
color-link identifier.var "#b7a98d"
color-link constant "#6296a0"
color-link constant.number "#968975"
color-link constant.string "#898b77"
color-link constant.specialChar "#b79a95"
color-link constant.string.url "#b7a98d"
color-link statement "#b79a95"
color-link symbol.operator "#adb5b4"
color-link symbol.brackets "#9c9f87"
color-link symbol.tag "#b4a36f"
color-link preproc "#b7a98d"
color-link type "#b4a36f"
color-link type.keyword "#b4a36f"
color-link special "#b4a36f"
color-link underlined "#b7a98d,underline"
color-link error "bold #b17f6d"
color-link todo "bold #b4a36f"
color-link selection "#b7a98d,#454045"
color-link hlsearch "#232227,#6296a0"
color-link statusline "#232227,#837a69"
color-link statusline.inactive "#796f65,#2c2a2d"
color-link tabbar "#837a69,#2c2a2d"
color-link tabbar.inactive "#796f65,#2c2a2d"
color-link gutter-error "#b17f6d"
color-link gutter-warning "#b4a36f"
color-link line-number "#796f65,#2c2a2d"
color-link current-line-number "#b7a98d,#2c2a2d"
color-link diff-added "#898b77"
color-link diff-modified "#b4a36f"
color-link diff-deleted "#b17f6d"
color-link cursor-line "#2f2d31"
color-link color-column "#2f2d31"
color-link indent-char "#44403d"
color-link scrollbar "#796f65"

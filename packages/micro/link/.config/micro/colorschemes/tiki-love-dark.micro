# Tiki Love Dark

color-link default "#e8d5b7,#1a1410"
color-link comment "#6a7a52"
color-link identifier "#f0a84c"
color-link identifier.class "#6aaf5c"
color-link identifier.var "#e8d5b7"
color-link constant "#f0c06c"
color-link constant.number "#f0c06c"
color-link constant.string "#8acf7a"
color-link constant.specialChar "#5c9a7a"
color-link constant.string.url "#e8d5b7"
color-link statement "#d4843e"
color-link symbol.operator "#c4a97d"
color-link symbol.brackets "#8a7a60"
color-link symbol.tag "#d4843e"
color-link preproc "#e8d5b7"
color-link type "#d4843e"
color-link type.keyword "#d4843e"
color-link special "#d4843e"
color-link underlined "#e8d5b7,underline"
color-link error "bold #e85a4f"
color-link todo "bold #f0a84c"
color-link selection "#e8d5b7,#4c321c"
color-link hlsearch "#1a1410,#d4843e"
color-link statusline "#1a1410,#a0917d"
color-link statusline.inactive "#6a7a52,#26201a"
color-link tabbar "#a0917d,#26201a"
color-link tabbar.inactive "#6a7a52,#26201a"
color-link gutter-error "#e85a4f"
color-link gutter-warning "#f0a84c"
color-link line-number "#6a7a52,#26201a"
color-link current-line-number "#e8d5b7,#26201a"
color-link diff-added "#6aaf5c"
color-link diff-modified "#f0a84c"
color-link diff-deleted "#e85a4f"
color-link cursor-line "#2a2018"
color-link color-column "#2a2018"
color-link indent-char "#473e35"
color-link scrollbar "#6a7a52"

# TokyoNight (Day)
# https://github.com/folke/tokyonight.nvim

color-link default "#3760bf,#e1e2e7"
color-link comment "#a1a6c5"
color-link identifier "#3760bf"
color-link constant "#8c6c3e"
color-link constant.number "#8c6c3e"
color-link constant.string "#587539"
color-link constant.string.url "#007197"
color-link statement "#2e7de9"
color-link symbol.operator "#007197"
color-link preproc "#9854f1"
color-link type "#8c6c3e"
color-link special "#f52a65"
color-link underlined "#007197,underline"
color-link error "bold #f52a65"
color-link todo "bold #8c6c3e"
color-link selection "#3760bf,#b7c1e3"
color-link statusline "#e1e2e7,#587539"
color-link statusline.inactive "#a1a6c5,#b7c1e3"
color-link tabbar "#e1e2e7,#b7c1e3"
color-link tabbar.inactive "#a1a6c5,#b7c1e3"
color-link gutter-error "#f52a65"
color-link gutter-warning "#8c6c3e"
color-link line-number "#a1a6c5,#b7c1e3"
color-link current-line-number "#3760bf,#b7c1e3"
color-link diff-added "#587539"
color-link diff-modified "#8c6c3e"
color-link diff-deleted "#f52a65"

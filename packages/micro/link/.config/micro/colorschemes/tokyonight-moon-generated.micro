# Tokyonight Moon

color-link default "#c8d3f5,#222436"
color-link comment "#636da6"
color-link identifier "#82aaff"
color-link identifier.class "#0db9d7"
color-link identifier.var "#c8d3f5"
color-link constant "#ff966c"
color-link constant.number "#ff966c"
color-link constant.string "#c3e88d"
color-link constant.specialChar "#89ddff"
color-link constant.string.url "#c8d3f5"
color-link statement "#c099ff"
color-link symbol.operator "#89ddff"
color-link symbol.brackets "#89ddff"
color-link symbol.tag "#ff757f"
color-link preproc "#4fd6be"
color-link type "#c099ff"
color-link type.keyword "#c099ff"
color-link special "#ff757f"
color-link underlined "#c8d3f5,underline"
color-link error "bold #ff757f"
color-link todo "bold #ffc777"
color-link selection "#c8d3f5,#413150"
color-link hlsearch "#222436,#82aaff"
color-link statusline "#222436,#8e96b2"
color-link statusline.inactive "#636da6,#2c2e41"
color-link tabbar "#8e96b2,#2c2e41"
color-link tabbar.inactive "#636da6,#2c2e41"
color-link gutter-error "#ff757f"
color-link gutter-warning "#ffc777"
color-link line-number "#636da6,#2c2e41"
color-link current-line-number "#c8d3f5,#2c2e41"
color-link diff-added "#c3e88d"
color-link diff-modified "#ffc777"
color-link diff-deleted "#ff757f"
color-link cursor-line "#1c1d2c"
color-link color-column "#1c1d2c"
color-link indent-char "#474a60"
color-link scrollbar "#636da6"

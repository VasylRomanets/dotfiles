# TokyoNight (Moon)
# https://github.com/folke/tokyonight.nvim

color-link default "#c8d3f5,#222436"
color-link comment "#444a73"
color-link identifier "#c8d3f5"
color-link constant "#ffc777"
color-link constant.number "#ffc777"
color-link constant.string "#c3e88d"
color-link constant.string.url "#86e1fc"
color-link statement "#82aaff"
color-link symbol.operator "#86e1fc"
color-link preproc "#c099ff"
color-link type "#ffc777"
color-link special "#ff757f"
color-link underlined "#86e1fc,underline"
color-link error "bold #ff757f"
color-link todo "bold #ffc777"
color-link selection "#c8d3f5,#2d3f76"
color-link statusline "#222436,#c3e88d"
color-link statusline.inactive "#444a73,#2d3f76"
color-link tabbar "#222436,#2d3f76"
color-link tabbar.inactive "#444a73,#2d3f76"
color-link gutter-error "#ff757f"
color-link gutter-warning "#ffc777"
color-link line-number "#444a73,#2d3f76"
color-link current-line-number "#c8d3f5,#2d3f76"
color-link diff-added "#c3e88d"
color-link diff-modified "#ffc777"
color-link diff-deleted "#ff757f"

# TokyoNight (Storm)
# https://github.com/folke/tokyonight.nvim

color-link default "#c0caf5,#24283b"
color-link comment "#414868"
color-link identifier "#c0caf5"
color-link constant "#e0af68"
color-link constant.number "#e0af68"
color-link constant.string "#9ece6a"
color-link constant.string.url "#7dcfff"
color-link statement "#7aa2f7"
color-link symbol.operator "#7dcfff"
color-link preproc "#bb9af7"
color-link type "#e0af68"
color-link special "#f7768e"
color-link underlined "#7dcfff,underline"
color-link error "bold #f7768e"
color-link todo "bold #e0af68"
color-link selection "#c0caf5,#2e3c64"
color-link statusline "#24283b,#9ece6a"
color-link statusline.inactive "#414868,#2e3c64"
color-link tabbar "#24283b,#2e3c64"
color-link tabbar.inactive "#414868,#2e3c64"
color-link gutter-error "#f7768e"
color-link gutter-warning "#e0af68"
color-link line-number "#414868,#2e3c64"
color-link current-line-number "#c0caf5,#2e3c64"
color-link diff-added "#9ece6a"
color-link diff-modified "#e0af68"
color-link diff-deleted "#f7768e"

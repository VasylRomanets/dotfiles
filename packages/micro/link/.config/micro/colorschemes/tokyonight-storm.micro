# Tokyonight Storm

color-link default "#c0caf5,#24283b"
color-link comment "#565f89"
color-link identifier "#7aa2f7"
color-link identifier.class "#0db9d7"
color-link identifier.var "#c0caf5"
color-link constant "#ff9e64"
color-link constant.number "#ff9e64"
color-link constant.string "#9ece6a"
color-link constant.specialChar "#89ddff"
color-link constant.string.url "#c0caf5"
color-link statement "#bb9af7"
color-link symbol.operator "#89ddff"
color-link symbol.brackets "#89ddff"
color-link symbol.tag "#f7768e"
color-link preproc "#73daca"
color-link type "#bb9af7"
color-link type.keyword "#bb9af7"
color-link special "#f7768e"
color-link underlined "#c0caf5,underline"
color-link error "bold #f7768e"
color-link todo "bold #e0af68"
color-link selection "#c0caf5,#423454"
color-link hlsearch "#24283b,#7aa2f7"
color-link statusline "#24283b,#8991b4"
color-link statusline.inactive "#565f89,#2d3246"
color-link tabbar "#8991b4,#2d3246"
color-link tabbar.inactive "#565f89,#2d3246"
color-link gutter-error "#f7768e"
color-link gutter-warning "#e0af68"
color-link line-number "#565f89,#2d3246"
color-link current-line-number "#c0caf5,#2d3246"
color-link diff-added "#9ece6a"
color-link diff-modified "#e0af68"
color-link diff-deleted "#f7768e"
color-link cursor-line "#1d2030"
color-link color-column "#1d2030"
color-link indent-char "#464c64"
color-link scrollbar "#565f89"

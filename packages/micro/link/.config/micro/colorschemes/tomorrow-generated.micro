# Tomorrow

color-link default "#4d4d4c,#ffffff"
color-link comment "#8e908c"
color-link identifier "#4271ae"
color-link identifier.class "#c99e00"
color-link identifier.var "#c82829"
color-link constant "#f5871f"
color-link constant.number "#f5871f"
color-link constant.string "#718c00"
color-link constant.specialChar "#f5871f"
color-link constant.string.url "#4d4d4c"
color-link statement "#8959a8"
color-link symbol.operator "#3e999f"
color-link symbol.brackets "#4d4d4c"
color-link symbol.tag "#c82829"
color-link preproc "#4d4d4c"
color-link type "#8959a8"
color-link type.keyword "#8959a8"
color-link special "#c82829"
color-link underlined "#4d4d4c,underline"
color-link error "bold #ffffff"
color-link todo "bold #eab700"
color-link selection "#4d4d4c,#d6d6d6"
color-link hlsearch "#ffffff,#3e999f"
color-link statusline "#ffffff,#8b8b8b"
color-link statusline.inactive "#8e908c,#f4f4f4"
color-link tabbar "#8b8b8b,#f4f4f4"
color-link tabbar.inactive "#8e908c,#f4f4f4"
color-link gutter-error "#c82829"
color-link gutter-warning "#eab700"
color-link line-number "#8e908c,#f4f4f4"
color-link current-line-number "#4d4d4c,#f4f4f4"
color-link diff-added "#718c00"
color-link diff-modified "#eab700"
color-link diff-deleted "#c82829"
color-link cursor-line "#efefef"
color-link color-column "#efefef"
color-link indent-char "#d8d8d8"
color-link scrollbar "#8e908c"

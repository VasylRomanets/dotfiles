# Tomorrow Night Blue

color-link default "#ffffff,#002451"
color-link comment "#7285b7"
color-link identifier "#bbdaff"
color-link identifier.class "#ffeead"
color-link identifier.var "#ff9da4"
color-link constant "#ffc58f"
color-link constant.number "#ffc58f"
color-link constant.string "#d1f1a9"
color-link constant.specialChar "#ffc58f"
color-link constant.string.url "#ffffff"
color-link statement "#ebbbff"
color-link symbol.operator "#99ffff"
color-link symbol.brackets "#ffffff"
color-link symbol.tag "#ff9da4"
color-link preproc "#ffffff"
color-link type "#ebbbff"
color-link type.keyword "#ebbbff"
color-link special "#ff9da4"
color-link underlined "#ffffff,underline"
color-link error "bold #ffffff"
color-link todo "bold #ffeead"
color-link selection "#ffffff,#003f8e"
color-link hlsearch "#002451,#99ffff"
color-link statusline "#002451,#a6b2c2"
color-link statusline.inactive "#7285b7,#0f315b"
color-link tabbar "#a6b2c2,#0f315b"
color-link tabbar.inactive "#7285b7,#0f315b"
color-link gutter-error "#ff9da4"
color-link gutter-warning "#ffeead"
color-link line-number "#7285b7,#0f315b"
color-link current-line-number "#ffffff,#0f315b"
color-link diff-added "#d1f1a9"
color-link diff-modified "#ffeead"
color-link diff-deleted "#ff9da4"
color-link cursor-line "#00346e"
color-link color-column "#00346e"
color-link indent-char "#385477"
color-link scrollbar "#7285b7"

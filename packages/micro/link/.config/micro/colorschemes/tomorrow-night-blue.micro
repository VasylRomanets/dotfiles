# Tomorrow Night Blue

color-link default "#ffffff,#002451"
color-link comment "#7285b7"
color-link identifier "#ffffff"
color-link constant "#ffeead"
color-link constant.number "#ffeead"
color-link constant.string "#d1f1a9"
color-link constant.string.url "#bbdaff"
color-link statement "#ebbbff"
color-link symbol.operator "#a6b2c2"
color-link preproc "#ebbbff"
color-link type "#99ffff"
color-link special "#ffeead"
color-link underlined "#bbdaff,underline"
color-link error "bold #ff9da4"
color-link todo "bold #ffeead"
color-link selection "#ffffff,#003f8e"
color-link statusline "#002451,#a6b2c2"
color-link statusline.inactive "#7285b7,#0d2f5a"
color-link tabbar "#a6b2c2,#0d2f5a"
color-link tabbar.inactive "#7285b7,#0d2f5a"
color-link gutter-error "#ff9da4"
color-link gutter-warning "#ffeead"
color-link line-number "#7285b7,#0d2f5a"
color-link current-line-number "#ffffff,#0d2f5a"
color-link diff-added "#d1f1a9"
color-link diff-modified "#ffeead"
color-link diff-deleted "#ff9da4"

# Tomorrow Night Bright

color-link default "#eaeaea,#000000"
color-link comment "#969896"
color-link identifier "#7aa6da"
color-link identifier.class "#e7c547"
color-link identifier.var "#d54e53"
color-link constant "#e78c45"
color-link constant.number "#e78c45"
color-link constant.string "#b9ca4a"
color-link constant.specialChar "#e78c45"
color-link constant.string.url "#dedede"
color-link statement "#c397d8"
color-link symbol.operator "#70c0b1"
color-link symbol.brackets "#dedede"
color-link symbol.tag "#d54e53"
color-link preproc "#dedede"
color-link type "#c397d8"
color-link type.keyword "#c397d8"
color-link special "#d54e53"
color-link underlined "#dedede,underline"
color-link error "bold #ced2cf"
color-link todo "bold #e7c547"
color-link selection "#eaeaea,#424242"
color-link hlsearch "#000000,#70c0b1"
color-link statusline "#000000,#989898"
color-link statusline.inactive "#969896,#0e0e0e"
color-link tabbar "#989898,#0e0e0e"
color-link tabbar.inactive "#969896,#0e0e0e"
color-link gutter-error "#d54e53"
color-link gutter-warning "#e7c547"
color-link line-number "#969896,#0e0e0e"
color-link current-line-number "#eaeaea,#0e0e0e"
color-link diff-added "#b9ca4a"
color-link diff-modified "#e7c547"
color-link diff-deleted "#d54e53"
color-link cursor-line "#2a2a2a"
color-link color-column "#2a2a2a"
color-link indent-char "#333333"
color-link scrollbar "#969896"

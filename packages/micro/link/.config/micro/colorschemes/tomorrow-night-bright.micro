# Tomorrow Night Bright

color-link default "#eaeaea,#000000"
color-link comment "#969896"
color-link identifier "#eaeaea"
color-link constant "#e7c547"
color-link constant.number "#e7c547"
color-link constant.string "#b9ca4a"
color-link constant.string.url "#7aa6da"
color-link statement "#c397d8"
color-link symbol.operator "#989898"
color-link preproc "#c397d8"
color-link type "#70c0b1"
color-link special "#e7c547"
color-link underlined "#7aa6da,underline"
color-link error "bold #d54e53"
color-link todo "bold #e7c547"
color-link selection "#eaeaea,#424242"
color-link statusline "#000000,#989898"
color-link statusline.inactive "#969896,#0c0c0c"
color-link tabbar "#989898,#0c0c0c"
color-link tabbar.inactive "#969896,#0c0c0c"
color-link gutter-error "#d54e53"
color-link gutter-warning "#e7c547"
color-link line-number "#969896,#0c0c0c"
color-link current-line-number "#eaeaea,#0c0c0c"
color-link diff-added "#b9ca4a"
color-link diff-modified "#e7c547"
color-link diff-deleted "#d54e53"

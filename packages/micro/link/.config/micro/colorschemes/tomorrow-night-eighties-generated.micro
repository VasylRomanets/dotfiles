# Tomorrow Night Eighties

color-link default "#cccccc,#2d2d2d"
color-link comment "#999999"
color-link identifier "#6699cc"
color-link identifier.class "#ffcc66"
color-link identifier.var "#f2777a"
color-link constant "#f99157"
color-link constant.number "#f99157"
color-link constant.string "#99cc99"
color-link constant.specialChar "#f99157"
color-link constant.string.url "#cccccc"
color-link statement "#cc99cc"
color-link symbol.operator "#66cccc"
color-link symbol.brackets "#cccccc"
color-link symbol.tag "#f2777a"
color-link preproc "#cccccc"
color-link type "#cc99cc"
color-link type.keyword "#cc99cc"
color-link special "#f2777a"
color-link underlined "#cccccc,underline"
color-link error "bold #cdcdcd"
color-link todo "bold #ffcc66"
color-link selection "#cccccc,#515151"
color-link hlsearch "#2d2d2d,#66cccc"
color-link statusline "#2d2d2d,#949494"
color-link statusline.inactive "#999999,#373737"
color-link tabbar "#949494,#373737"
color-link tabbar.inactive "#999999,#373737"
color-link gutter-error "#f2777a"
color-link gutter-warning "#ffcc66"
color-link line-number "#999999,#373737"
color-link current-line-number "#cccccc,#373737"
color-link diff-added "#99cc99"
color-link diff-modified "#ffcc66"
color-link diff-deleted "#f2777a"
color-link cursor-line "#393939"
color-link color-column "#393939"
color-link indent-char "#505050"
color-link scrollbar "#999999"

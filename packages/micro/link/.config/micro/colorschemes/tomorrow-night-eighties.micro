# Tomorrow Night Eighties

color-link default "#cccccc,#2d2d2d"
color-link comment "#999999"
color-link identifier "#cccccc"
color-link constant "#ffcc66"
color-link constant.number "#ffcc66"
color-link constant.string "#99cc99"
color-link constant.string.url "#6699cc"
color-link statement "#cc99cc"
color-link symbol.operator "#949494"
color-link preproc "#cc99cc"
color-link type "#66cccc"
color-link special "#ffcc66"
color-link underlined "#6699cc,underline"
color-link error "bold #f2777a"
color-link todo "bold #ffcc66"
color-link selection "#cccccc,#515151"
color-link statusline "#2d2d2d,#949494"
color-link statusline.inactive "#999999,#353535"
color-link tabbar "#949494,#353535"
color-link tabbar.inactive "#999999,#353535"
color-link gutter-error "#f2777a"
color-link gutter-warning "#ffcc66"
color-link line-number "#999999,#353535"
color-link current-line-number "#cccccc,#353535"
color-link diff-added "#99cc99"
color-link diff-modified "#ffcc66"
color-link diff-deleted "#f2777a"

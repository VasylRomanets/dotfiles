# Tomorrow Night

color-link default "#c5c8c6,#1d1f21"
color-link comment "#969896"
color-link identifier "#81a2be"
color-link identifier.class "#f0c674"
color-link identifier.var "#cc6666"
color-link constant "#de935f"
color-link constant.number "#de935f"
color-link constant.string "#b5bd68"
color-link constant.specialChar "#de935f"
color-link constant.string.url "#c5c8c6"
color-link statement "#b294bb"
color-link symbol.operator "#8abeb7"
color-link symbol.brackets "#c5c8c6"
color-link symbol.tag "#cc6666"
color-link preproc "#c5c8c6"
color-link type "#b294bb"
color-link type.keyword "#b294bb"
color-link special "#cc6666"
color-link underlined "#c5c8c6,underline"
color-link error "bold #ced2cf"
color-link todo "bold #f0c674"
color-link selection "#c5c8c6,#373b41"
color-link hlsearch "#1d1f21,#8abeb7"

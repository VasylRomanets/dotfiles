# Tomorrow Night

color-link default "#c5c8c6,#1d1f21"
color-link comment "#969896"
color-link identifier "#c5c8c6"
color-link constant "#f0c674"
color-link constant.number "#f0c674"
color-link constant.string "#b5bd68"
color-link constant.string.url "#81a2be"
color-link statement "#b294bb"
color-link symbol.operator "#8a8d8c"
color-link preproc "#b294bb"
color-link type "#8abeb7"
color-link special "#f0c674"
color-link underlined "#81a2be,underline"
color-link error "bold #cc6666"
color-link todo "bold #f0c674"
color-link selection "#c5c8c6,#373b41"
color-link statusline "#1d1f21,#8a8d8c"
color-link statusline.inactive "#969896,#252729"
color-link tabbar "#8a8d8c,#252729"
color-link tabbar.inactive "#969896,#252729"
color-link gutter-error "#cc6666"
color-link gutter-warning "#f0c674"
color-link line-number "#969896,#252729"
color-link current-line-number "#c5c8c6,#252729"
color-link diff-added "#b5bd68"
color-link diff-modified "#f0c674"
color-link diff-deleted "#cc6666"

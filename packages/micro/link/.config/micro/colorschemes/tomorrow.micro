# Tomorrow

color-link default "#4d4d4c,#ffffff"
color-link comment "#8e908c"
color-link identifier "#4d4d4c"
color-link constant "#eab700"
color-link constant.number "#eab700"
color-link constant.string "#718c00"
color-link constant.string.url "#4271ae"
color-link statement "#8959a8"
color-link symbol.operator "#8b8b8b"
color-link preproc "#8959a8"
color-link type "#3e999f"
color-link special "#eab700"
color-link underlined "#4271ae,underline"
color-link error "bold #c82829"
color-link todo "bold #eab700"
color-link selection "#4d4d4c,#d6d6d6"
color-link statusline "#ffffff,#8b8b8b"
color-link statusline.inactive "#8e908c,#f6f6f6"
color-link tabbar "#8b8b8b,#f6f6f6"
color-link tabbar.inactive "#8e908c,#f6f6f6"
color-link gutter-error "#c82829"
color-link gutter-warning "#eab700"
color-link line-number "#8e908c,#f6f6f6"
color-link current-line-number "#4d4d4c,#f6f6f6"
color-link diff-added "#718c00"
color-link diff-modified "#eab700"
color-link diff-deleted "#c82829"

# Tundra Arctic

color-link default "#d1d5db,#111827"
color-link comment "#6b7280"
color-link identifier "#bae6fd"
color-link identifier.class "#d1d5db"
color-link identifier.var "#d1d5db"
color-link constant "#d1d5db"
color-link constant.number "#fbc19d"
color-link constant.string "#b5e8b0"
color-link constant.specialChar "#d1d5db"
color-link constant.string.url "#d1d5db"
color-link statement "#fca5a5"
color-link symbol.operator "#fca5a5"
color-link symbol.brackets "#d1d5db"
color-link symbol.tag "#ddd6fe"
color-link preproc "#ddd6fe"
color-link type "#fecdd3"
color-link type.keyword "#fecdd3"
color-link special "#ddd6fe"
color-link underlined "#d1d5db,underline"
color-link error "bold #d1d5db"
color-link todo "bold #fbc19d"
color-link selection "#d1d5db,#374151"
color-link hlsearch "#111827,#bae6fd"
color-link statusline "#111827,#8e939c"
color-link statusline.inactive "#6b7280,#1d2332"
color-link tabbar "#8e939c,#1d2332"
color-link tabbar.inactive "#6b7280,#1d2332"
color-link gutter-error "#fca5a5"
color-link gutter-warning "#fbc19d"
color-link line-number "#6b7280,#1d2332"
color-link current-line-number "#d1d5db,#1d2332"
color-link diff-added "#b1e3ad"
color-link diff-modified "#fbc19d"
color-link diff-deleted "#fca5a5"
color-link cursor-line "#1d2332"
color-link color-column "#1d2332"
color-link indent-char "#3b424f"
color-link scrollbar "#6b7280"

# Tundra Arctic

color-link default "#D1D5DB,#111827"
color-link comment "#6B7280"
color-link identifier "#BAE6FD"
color-link constant "#FBC19D"
color-link constant.number "#FBC19D"
color-link constant.string "#B5E8B0"
color-link constant.string.url "#BAE6FD"
color-link statement "#FCA5A5"
color-link symbol.operator "#8e939c"
color-link preproc "#DDD6FE"
color-link type "#FECDD3"
color-link special "#FBC19D"
color-link underlined "#BAE6FD,underline"
color-link error "bold #FCA5A5"
color-link todo "bold #FBC19D"
color-link selection "#D1D5DB,#374151"
color-link statusline "#111827,#8e939c"
color-link statusline.inactive "#6B7280,#1b2130"
color-link tabbar "#8e939c,#1b2130"
color-link tabbar.inactive "#6B7280,#1b2130"
color-link gutter-error "#FCA5A5"
color-link gutter-warning "#FBC19D"
color-link line-number "#6B7280,#1b2130"
color-link current-line-number "#D1D5DB,#1b2130"

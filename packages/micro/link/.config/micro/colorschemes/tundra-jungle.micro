# Tundra Jungle

color-link default "#d1d5db,#1c1c1c"
color-link comment "#767676"
color-link identifier "#acd5fc"
color-link identifier.class "#d1d5db"
color-link identifier.var "#d1d5db"
color-link constant "#d1d5db"
color-link constant.number "#f5cfa9"
color-link constant.string "#afd7af"
color-link constant.specialChar "#d1d5db"
color-link constant.string.url "#d1d5db"
color-link statement "#ffafaf"
color-link symbol.operator "#ffafaf"
color-link symbol.brackets "#d1d5db"
color-link symbol.tag "#d7d7ff"
color-link preproc "#d7d7ff"
color-link type "#ffd7d7"
color-link type.keyword "#ffd7d7"
color-link special "#d7d7ff"
color-link underlined "#d1d5db,underline"
color-link error "bold #d1d5db"
color-link todo "bold #f5cfa9"
color-link selection "#d1d5db,#444444"
color-link hlsearch "#1c1c1c,#acd5fc"
color-link statusline "#1c1c1c,#929498"
color-link statusline.inactive "#767676,#272727"
color-link tabbar "#929498,#272727"
color-link tabbar.inactive "#767676,#272727"
color-link gutter-error "#ffafaf"
color-link gutter-warning "#f5cfa9"
color-link line-number "#767676,#272727"
color-link current-line-number "#d1d5db,#272727"
color-link diff-added "#afd7af"
color-link diff-modified "#f5cfa9"
color-link diff-deleted "#ffafaf"
color-link cursor-line "#272727"
color-link color-column "#272727"
color-link indent-char "#444546"
color-link scrollbar "#767676"

# Vesper

color-link default "#ffffff,#101010"
color-link comment "#8b8b8b"
color-link identifier "#ffc799"
color-link constant "#ffc799"
color-link constant.number "#ffc799"
color-link constant.string "#99ffe4"
color-link constant.string.url "#aca1cf"
color-link statement "#a0a0a0"
color-link symbol.operator "#ababab"
color-link preproc "#a0a0a0"
color-link type "#ffc799"
color-link special "#ffc799"
color-link underlined "#aca1cf,underline"
color-link error "bold #ff8080"
color-link todo "bold #e6b99d"
color-link selection "#ffffff,#313131"
color-link statusline "#101010,#ababab"
color-link statusline.inactive "#707070,#1c1c1c"
color-link tabbar "#ababab,#1c1c1c"
color-link tabbar.inactive "#707070,#1c1c1c"
color-link gutter-error "#f5a191"
color-link gutter-warning "#e6b99d"
color-link line-number "#707070,#1c1c1c"
color-link current-line-number "#ffffff,#1c1c1c"
color-link diff-added "#90b99f"
color-link diff-modified "#e6b99d"
color-link diff-deleted "#f5a191"

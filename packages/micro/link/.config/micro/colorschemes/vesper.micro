# Vesper

color-link default "#ffffff,#101010"
color-link comment "#8b8b8b"
color-link identifier "#ffc799"
color-link identifier.class "#ffc799"
color-link identifier.var "#ffffff"
color-link constant "#ffffff"
color-link constant.number "#ffc799"
color-link constant.string "#99ffe4"
color-link constant.specialChar "#a0a0a0"
color-link constant.string.url "#ffffff"
color-link statement "#a0a0a0"
color-link symbol.operator "#a0a0a0"
color-link symbol.brackets "#ffffff"
color-link symbol.tag "#ffc799"
color-link preproc "#ffffff"
color-link type "#a0a0a0"
color-link type.keyword "#a0a0a0"
color-link special "#ffc799"
color-link underlined "#ffffff,underline"
color-link error "bold #ff8080"
color-link todo "bold #e6b99d"
color-link selection "#ffffff,#313131"
color-link hlsearch "#101010,#ea83a5"
color-link statusline "#101010,#ababab"
color-link statusline.inactive "#8b8b8b,#1e1e1e"
color-link tabbar "#ababab,#1e1e1e"
color-link tabbar.inactive "#8b8b8b,#1e1e1e"
color-link gutter-error "#f5a191"
color-link gutter-warning "#e6b99d"
color-link line-number "#8b8b8b,#1e1e1e"
color-link current-line-number "#ffffff,#1e1e1e"
color-link diff-added "#90b99f"
color-link diff-modified "#e6b99d"
color-link diff-deleted "#f5a191"
color-link cursor-line "#1e1e1e"
color-link color-column "#1e1e1e"
color-link indent-char "#454545"
color-link scrollbar "#8b8b8b"

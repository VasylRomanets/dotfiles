# Warm Burnout Dark

color-link default "#bfbdb6,#1a1510"
color-link comment "#b4a89c"
color-link identifier "#ffb454"
color-link identifier.class "#90aec0"
color-link identifier.var "#bfbdb6"
color-link constant "#d4a8b8"
color-link constant.number "#d4a8b8"
color-link constant.string "#b4bc78"
color-link constant.specialChar "#96b898"
color-link constant.string.url "#bfbdb6"
color-link statement "#ff8f40"
color-link symbol.operator "#f29668"
color-link symbol.brackets "#bfbdb6"
color-link symbol.tag "#dc9e92"
color-link preproc "#bfbdb6"
color-link type "#ff8f40"
color-link type.keyword "#ff8f40"
color-link special "#dc9e92"
color-link underlined "#bfbdb6,underline"
color-link error "bold #f49090"
color-link todo "bold #fdb04c"
color-link selection "#bfbdb6,#33393a"
color-link hlsearch "#1a1510,#93e2c8"
color-link statusline "#1a1510,#85827c"
color-link statusline.inactive "#b4a89c,#241f1a"
color-link tabbar "#85827c,#241f1a"
color-link tabbar.inactive "#b4a89c,#241f1a"
color-link gutter-error "#f06b73"
color-link gutter-warning "#fdb04c"
color-link line-number "#b4a89c,#241f1a"
color-link current-line-number "#bfbdb6,#241f1a"
color-link diff-added "#70bf56"
color-link diff-modified "#fdb04c"
color-link diff-deleted "#f06b73"
color-link cursor-line "#222018"
color-link color-column "#222018"
color-link indent-char "#3e3a35"
color-link scrollbar "#b4a89c"

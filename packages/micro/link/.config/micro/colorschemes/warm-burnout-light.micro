# Warm Burnout Light

color-link default "#3a3630,#f5ede0"
color-link comment "#544c40"
color-link identifier "#855700"
color-link identifier.class "#285464"
color-link identifier.var "#3a3630"
color-link constant "#7e4060"
color-link constant.number "#7e4060"
color-link constant.string "#4d5c1a"
color-link constant.specialChar "#286a48"
color-link constant.string.url "#3a3630"
color-link statement "#924800"
color-link symbol.operator "#8f4418"
color-link symbol.brackets "#3a3630"
color-link symbol.tag "#8e4632"
color-link preproc "#3a3630"
color-link type "#924800"
color-link type.keyword "#924800"
color-link special "#8e4632"
color-link underlined "#3a3630,underline"
color-link error "bold #b03434"
color-link todo "bold #8a6000"
color-link selection "#3a3630,#e5e8e2"
color-link hlsearch "#f5ede0,#146858"
color-link statusline "#f5ede0,#7b766e"
color-link statusline.inactive "#544c40,#eae2d5"
color-link tabbar "#7b766e,#eae2d5"
color-link tabbar.inactive "#544c40,#eae2d5"
color-link gutter-error "#b82820"
color-link gutter-warning "#8a6000"
color-link line-number "#544c40,#eae2d5"
color-link current-line-number "#3a3630,#eae2d5"
color-link diff-added "#2d6a14"
color-link diff-modified "#8a6000"
color-link diff-deleted "#b82820"
color-link cursor-line "#e2dace"
color-link color-column "#e2dace"
color-link indent-char "#ccc5b9"
color-link scrollbar "#544c40"

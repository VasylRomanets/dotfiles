# White Gold

color-link default "#0c0c14,#dedbc8"
color-link comment "#645c4b"
color-link identifier "#005c32"
color-link identifier.class "#2e311a"
color-link identifier.var "#4b0304"
color-link constant "#4b0304"
color-link constant.number "#4b0304"
color-link constant.string "#725c0a"
color-link constant.specialChar "#3b3b3b"
color-link constant.string.url "#0c0c14"
color-link statement "#762b2f"
color-link symbol.operator "#762b2f"
color-link symbol.brackets "#0c0c14"
color-link symbol.tag "#4b0304"
color-link preproc "#0c0c14"
color-link type "#2e311a"
color-link type.keyword "#2e311a"
color-link special "#4b0304"
color-link underlined "#0c0c14,underline"
color-link error "bold #4b0304"
color-link todo "bold #6c5319"
color-link selection "#0c0c14,#c4c1ac"
color-link hlsearch "#dedbc8,#005c32"
color-link statusline "#dedbc8,#555453"
color-link statusline.inactive "#645c4b,#d1cfbd"
color-link tabbar "#555453,#d1cfbd"
color-link tabbar.inactive "#645c4b,#d1cfbd"
color-link gutter-error "#4b0304"
color-link gutter-warning "#6c5319"
color-link line-number "#645c4b,#d1cfbd"
color-link current-line-number "#0c0c14,#d1cfbd"
color-link diff-added "#005c32"
color-link diff-modified "#6c5319"
color-link diff-deleted "#4b0304"
color-link cursor-line "#e9e6d3"
color-link color-column "#e9e6d3"
color-link indent-char "#b0ada0"
color-link scrollbar "#645c4b"

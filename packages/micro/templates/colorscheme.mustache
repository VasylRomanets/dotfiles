# {{{scheme.name}}}

color-link default "#{{ui.global.foreground.normal.hex}},#{{ui.global.background.normal.hex}}"
color-link comment "#{{syntax.comment.default.hex}}"
color-link identifier "#{{syntax.entity.name.function.default.hex}}"
color-link identifier.class "#{{syntax.entity.name.class.hex}}"
color-link identifier.var "#{{syntax.variable.default.hex}}"
color-link constant "#{{syntax.constant.language.hex}}"
color-link constant.number "#{{syntax.constant.numeric.default.hex}}"
color-link constant.string "#{{syntax.string.default.hex}}"
color-link constant.specialChar "#{{syntax.constant.character.escape.hex}}"
color-link constant.string.url "#{{syntax.markup.link.hex}}"
color-link statement "#{{syntax.keyword.default.hex}}"
color-link symbol.operator "#{{syntax.keyword.operator.hex}}"
color-link symbol.brackets "#{{syntax.punctuation.brackets.default.hex}}"
color-link symbol.tag "#{{syntax.entity.name.tag.hex}}"
color-link preproc "#{{syntax.meta.preprocessor.hex}}"
color-link type "#{{syntax.storage.type.hex}}"
color-link type.keyword "#{{syntax.storage.type.hex}}"
color-link special "#{{syntax.entity.name.tag.hex}}"
color-link underlined "#{{syntax.markup.link.hex}},underline"
color-link error "bold #{{syntax.invalid.default.hex}}"
color-link todo "bold #{{ui.status.warning.hex}}"
color-link selection "#{{ui.selection.foreground.hex}},#{{ui.selection.background.hex}}"
color-link hlsearch "#{{ui.global.background.normal.hex}},#{{ui.accent.normal.hex}}"
color-link statusline "#{{ui.global.background.normal.hex}},#{{ui.chrome.foreground.dark.hex}}"
color-link statusline.inactive "#{{syntax.comment.default.hex}},#{{ui.chrome.background.normal.hex}}"
color-link tabbar "#{{ui.chrome.foreground.dark.hex}},#{{ui.chrome.background.normal.hex}}"
color-link tabbar.inactive "#{{syntax.comment.default.hex}},#{{ui.chrome.background.normal.hex}}"
color-link gutter-error "#{{ui.status.error.hex}}"
color-link gutter-warning "#{{ui.status.warning.hex}}"
color-link line-number "#{{ui.gutter.foreground.hex}},#{{ui.chrome.background.normal.hex}}"
color-link current-line-number "#{{ui.global.foreground.normal.hex}},#{{ui.chrome.background.normal.hex}}"
color-link diff-added "#{{ui.status.success.hex}}"
color-link diff-modified "#{{ui.status.warning.hex}}"
color-link diff-deleted "#{{ui.status.error.hex}}"
color-link cursor-line "#{{ui.highlight.line.background.hex}}"
color-link color-column "#{{ui.highlight.line.background.hex}}"
color-link indent-char "#{{ui.border.normal.hex}}"
color-link scrollbar "#{{ui.gutter.foreground.hex}}"

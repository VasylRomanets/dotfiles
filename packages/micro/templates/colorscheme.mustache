# {{name}}

color-link default "{{ui.foreground}},{{ui.background}}"
color-link comment "{{syntax.comment}}"
color-link identifier "{{syntax.entity.name.function}}"
color-link identifier.class "{{syntax.entity.name.class}}"
color-link identifier.var "{{syntax.variable}}"
color-link constant "{{syntax.constant.language}}"
color-link constant.number "{{syntax.constant.numeric}}"
color-link constant.string "{{syntax.string}}"
color-link constant.specialChar "{{syntax.constant.character.escape}}"
color-link constant.string.url "{{syntax.markup.link}}"
color-link statement "{{syntax.keyword}}"
color-link symbol.operator "{{syntax.keyword.operator}}"
color-link symbol.brackets "{{syntax.punctuation.brackets}}"
color-link symbol.tag "{{syntax.entity.name.tag}}"
color-link preproc "{{syntax.meta.preprocessor}}"
color-link type "{{syntax.storage.type}}"
color-link type.keyword "{{syntax.storage.type}}"
color-link special "{{syntax.entity.name.tag}}"
color-link underlined "{{syntax.markup.link}},underline"
color-link error "bold {{syntax.invalid}}"
color-link todo "bold {{ui.warning}}"
color-link selection "{{ui.selection-fg}},{{ui.selection-bg}}"
color-link hlsearch "{{ui.background}},{{ui.accent}}"
color-link statusline "{{ui.background}},{{ui.chrome-fg-dark}}"
color-link statusline.inactive "{{syntax.comment}},{{ui.chrome-bg}}"
color-link tabbar "{{ui.chrome-fg-dark}},{{ui.chrome-bg}}"
color-link tabbar.inactive "{{syntax.comment}},{{ui.chrome-bg}}"
color-link gutter-error "{{ui.error}}"
color-link gutter-warning "{{ui.warning}}"
color-link line-number "{{ui.gutter-fg}},{{ui.chrome-bg}}"
color-link current-line-number "{{ui.foreground}},{{ui.chrome-bg}}"
color-link diff-added "{{ui.success}}"
color-link diff-modified "{{ui.warning}}"
color-link diff-deleted "{{ui.error}}"
color-link cursor-line "{{ui.line-highlight}}"
color-link color-column "{{ui.line-highlight}}"
color-link indent-char "{{ui.border}}"
color-link scrollbar "{{ui.gutter-fg}}"

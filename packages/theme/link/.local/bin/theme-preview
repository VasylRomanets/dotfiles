#!/usr/bin/env bash

# Print a sample file highlighted in a theme's colors, on the theme's own
# background. Used as the fzf preview in theme's picker.
#
# bat only emits foreground colors, so the background (exported per theme in
# the colors directory, see packages/theme/templates) is painted here:
# re-applied after every reset bat emits, then extended to the pane's edges
# and bottom with erase-to-end-of-line.
#
# REQUIRES: bat (brew install bat)
#
# USAGE: theme-preview <slug>

data_dir="${XDG_DATA_HOME:-$HOME/.local/share}/theme"
sample="$data_dir/the-office.py"
esc=$'\033'

slug=$1

# Defines BG, the theme's background as hex digits.
# shellcheck source=/dev/null
source "$data_dir/colors/$slug.env" 2>/dev/null

# bat's theme for a slug is the supplied one, else the generated one.
bat_theme=$slug
[[ -e "${XDG_CONFIG_HOME:-$HOME/.config}/bat/themes/$slug.tmTheme" ]] || bat_theme="$slug-generated"

output=$(bat --color=always --paging=never --terminal-width="${FZF_PREVIEW_COLUMNS:-100}" \
  --theme="$bat_theme" -- "$sample" 2>&1)

# Without a background to paint, show bat's output as is.
if [[ -z "$BG" ]]; then
  printf '%s\n' "$output"
  exit 0
fi

bg="${esc}[48;2;$((16#${BG:0:2}));$((16#${BG:2:2}));$((16#${BG:4:2}))m"

printf '%s\n' "$output" | sed "s/${esc}\[0m/&${bg}/g; s/^/${bg}/; s/\$/${esc}[K/"

# Fill the rest of the pane so the background reaches the bottom edge.
printed=$(printf '%s\n' "$output" | wc -l)
for ((i = printed; i < ${FZF_PREVIEW_LINES:-0}; i++)); do
  printf '%s%s[K\n' "$bg" "$esc"
done

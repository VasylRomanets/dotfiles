#!/usr/bin/env bash

# Switch the active theme — fuzzy pick, direct select, or randomize.
#
# This script only resolves the chosen slug and writes it to the state file.
# bat, fzf, and vivid react to that reactively on their next use (see
# packages/theme/source/theme.zsh and packages/vivid/source/vivid.zsh).
# Every other theme-aware package (Ghostty, Yazi, git/delta, micro) reacts
# independently via its own hooks/theme-changed.zsh, symlinked into
# hooks.d/ by setup/sync.zsh — this script doesn't know they exist.
#
# REQUIRES: fzf (brew install fzf)
#
# USAGE: theme-set           — fuzzy picker
#        theme-set <name>    — apply directly or pre-filter picker
#        theme-set -r        — apply a random theme
#
# Author:  Vasyl Romanets
# GitHub:  https://github.com/vasylromanets
# Created: 2026-09-13
# License: MIT

# The picker below must work even when the generated fzf theme file doesn't
# exist yet (fzf errors out on a missing FZF_DEFAULT_OPTS_FILE) — this script
# is what creates it.
unset FZF_DEFAULT_OPTS_FILE

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/theme"
state_file="$state_dir/current-theme.txt"
hooks_dir="${XDG_DATA_HOME:-$HOME/.local/share}/theme/hooks.d"
mkdir -p "$state_dir"
touch "$state_file"

themes=(
  "birds-of-paradise"
  "catppuccin-frappe"
  "catppuccin-latte"
  "catppuccin-macchiato"
  "catppuccin-mocha"
  "duskfox"
  "ember"
  "ember-light"
  "ember-soft"
  "everforest-dark-hard"
  "kanagawa-dragon"
  "kanagawa-lotus"
  "kanagawa-wave"
  "kanso-ink"
  "kanso-mist"
  "kanso-pearl"
  "kanso-zen"
  "miasma"
  "noctis"
  "noctis-azureus"
  "noctis-bordo"
  "noctis-hibernus"
  "noctis-lilac"
  "noctis-lux"
  "noctis-minimus"
  "noctis-obscuro"
  "noctis-sereno"
  "noctis-uva"
  "noctis-viola"
  "no-clown-fiesta"
  "no-clown-fiesta-light"
  "nord"
  "nord-wave"
  "rose-pine"
  "rose-pine-dawn"
  "rose-pine-moon"
  "sora"
  "tomorrow"
  "tomorrow-night"
  "tomorrow-night-blue"
  "tomorrow-night-bright"
  "tomorrow-night-eighties"
  "tokyonight-day"
  "vesper"
  "tundra-arctic"
  "tundra-jungle"
  "tokyonight-moon"
  "tokyonight-night"
  "tokyonight-storm"
)

# Converts a slug to its display name, e.g. rose-pine-moon -> Rose Pine Moon.
pretty_name() {
  local slug=$1 word result=""
  for word in ${slug//-/ }; do
    result="$result${result:+ }$(tr '[:lower:]' '[:upper:]' <<<"${word:0:1}")${word:1}"
  done
  printf '%s' "$result"
}

if [[ "$1" == "-r" ]]; then
  theme="${themes[RANDOM % ${#themes[@]}]}"
elif [[ -n "$1" ]] && printf '%s\n' "${themes[@]}" | grep -qxF "$1"; then
  theme="$1"
else
  # Show pretty names in the picker; the slug rides along as a hidden first
  # field so it's what actually comes back on selection, and so the preview
  # can render it with theme-preview. bat already has every theme pre-built
  # in its cache, so no rebuild is needed just to preview one.
  theme=$(
    for t in "${themes[@]}"; do
      printf '%s\t%s\n' "$t" "$(pretty_name "$t")"
    done | fzf --no-sort --delimiter='\t' --with-nth=2 --query="$1" \
      --no-scrollbar --preview-window='right:65%,border-none' \
      --preview="$(dirname "${BASH_SOURCE[0]}")/theme-preview {1}" \
      | cut -f1
  )
fi

[[ -z "$theme" ]] && exit 0

echo "$theme" >"$state_file"

# Fan out to every installed package's own reaction (see setup/sync.zsh for
# how hooks.d gets populated — a package without a theme-changed.zsh hook
# just isn't represented here).
for hook in "$hooks_dir"/*.zsh; do
  [[ -e "$hook" ]] || continue
  zsh "$hook" "$theme"
done

echo "$(pretty_name "$theme") theme is applied."
